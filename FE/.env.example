# LOOP Solutions — FE Environment Variables
# Copy this file to .env.local and fill in the values.

# ── API Configuration ──────────────────────────────────────────────────────────
# Backend API base URL (Next.js server)
# Default: http://localhost:3000/api (used when BE is running locally)
VITE_API_BASE_URL=http://localhost:3000/api

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to 'true' to use DEMO_USERS instead of calling the real backend.
# Useful when the BE is offline or for quick demos.
# Default: false (use real API)
VITE_DEMO_MODE=false

# ── Feature Flags ────────────────────────────────────────────────────────────
# Set to 'false' to disable heavy features in development.
VITE_ENABLE_REALTIME=true
VITE_ENABLE_EFFECTS=true
VITE_ENABLE_MEDIA_BOOKING=true

# ── App Metadata ──────────────────────────────────────────────────────────────
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
