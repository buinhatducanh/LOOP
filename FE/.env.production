# LOOP Solutions — FE Production Environment Variables
# This file is for production builds only (npm run build).
# DO NOT commit real production URLs. Use placeholders or fetch from GitHub Secrets.

# ── API Configuration ──────────────────────────────────────────────────────────
# Backend API base URL — set to production BE URL.
# Replace with actual production URL before deploying.
VITE_API_BASE_URL=https://loop8.io/api

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to 'false' in production to use real BE.
VITE_DEMO_MODE=false

# ── Feature Flags ────────────────────────────────────────────────────────────
VITE_ENABLE_REALTIME=true
VITE_ENABLE_EFFECTS=true
VITE_ENABLE_MEDIA_BOOKING=true

# ── App Metadata ──────────────────────────────────────────────────────────────
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
