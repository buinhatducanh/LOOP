// ─── Client VIP Status ─────────────────────────────────────────────────────────

/// Tracks VIP tier for each customer based on spending + VIP points.
/// Tier auto-promotes (never demotes) when conditions are met.
model ClientVipStatus {
  id            String   @id @default(cuid())
  userId        String?  @unique @map("user_id")
  userEmail     String   @unique @map("user_email")
  tier          String   @default("regular") // regular | vip1 | vip2 | vip3
  totalSpending Float    @default(0) // VNĐ — sum of Order.paidAmount (paid orders)
  vipPoints     Int      @default(0) // accumulated from client quests
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("client_vip_status")
}

model PointTransaction {
  id              String        @id @default(cuid())
  customerPointId String        @map("customer_point_id")
  type            String
  amount          Int
  source          String
  description     String
  referenceId     String?       @map("reference_id")
  referenceType   String?       @map("reference_type")
  status          String        @default("completed")
  expiresAt       DateTime?     @map("expires_at")
  expiredAt       DateTime?     @map("expired_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  customerPoint   CustomerPoint @relation(fields: [customerPointId], references: [id], onDelete: Cascade)

  @@index([customerPointId, createdAt])
  @@index([type, createdAt])
  @@map("point_transactions")
}

model PointActivity {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  nameVi           String   @map("name_vi")
  description      String?
  descriptionVi    String?  @map("description_vi")
  points           Int
  xpBonus          Int      @default(0) @map("xp_bonus")
  dailyLimit       Int?     @map("daily_limit")
  totalLimit       Int?     @map("total_limit")
  minLevel         Int      @default(1) @map("min_level")
  requiresPurchase Boolean  @default(false) @map("requires_purchase")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  adVideoUrl       String?  @map("ad_video_url")
  adDuration       Int?     @map("ad_duration")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("point_activities")
}

model Advertisement {
  id                String   @id @default(cuid())
  slug              String   @unique
  titleVi           String   @map("title_vi")
  description       String?
  descriptionVi     String?  @map("description_vi")
  videoUrl          String   @map("video_url")
  thumbnailPublicId String?  @map("thumbnail_public_id")
  thumbnailUrl      String?  @map("thumbnail_url")
  duration          Int
  points            Int      @default(10)
  xpBonus           Int      @default(0) @map("xp_bonus")
  dailyLimit        Int      @default(5) @map("daily_limit")
  watchCooldown     Int      @default(3600) @map("watch_cooldown")
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  minLevel          Int      @default(1) @map("min_level")
  requiresPurchase  Boolean  @default(false) @map("requires_purchase")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("advertisements")
}

model AdWatchHistory {
  id              String        @id @default(cuid())
  customerPointId String        @map("customer_point_id")
  advertisementId String        @map("advertisement_id")
  adSlug          String        @map("ad_slug")
  watchedAt       DateTime      @default(now()) @map("watched_at")
  pointsEarned    Int           @map("points_earned")
  xpEarned        Int           @default(0) @map("xp_earned")
  completed       Boolean       @default(false)
  watchDuration   Int           @default(0) @map("watch_duration")
  ipAddress       String?       @map("ip_address")
  createdAt       DateTime      @default(now()) @map("created_at")
  customerPoint   CustomerPoint @relation(fields: [customerPointId], references: [id], onDelete: Cascade)

  @@index([customerPointId, watchedAt])
  @@index([advertisementId])
  @@map("ad_watch_history")
}

model DailyReward {
  id        String   @id @default(cuid())
  day       Int      @unique
  points    Int
  xpBonus   Int      @default(0) @map("xp_bonus")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("daily_rewards")
}

model ServerAnalyticsEvent {
  id         String   @id @default(cuid())
  event      String
  properties Json     @default("{}")
  sessionId  String?  @map("session_id")
  visitorId  String?  @map("visitor_id")
  userId     String?  @map("user_id")
  locale     String?
  page       String?
  referrer   String?
  userAgent  String?  @map("user_agent")
  ip         String?
  country    String?
  city       String?
  device     String?
  browser    String?
  os         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([createdAt])
  @@index([sessionId])
  @@map("server_analytics_events")
}

/// Groups backlogs within a project. Coloured by PM for visual grouping.
model Epic {
  id        String    @id @default(cuid())
  title     String
  color     String    @default("#6366F1")
  createdAt DateTime  @default(now()) @map("created_at")
  isActive  Boolean   @default(true) @map("is_active")
  projectId String    @map("project_id")
  backlogs  Backlog[]
  project   Order     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("epics")
}

/// A container of tasks within a project. PM allocates LP budget (totalLp) to it.
model Backlog {
  id          String   @id @default(cuid())
  epicId      String?  @map("epic_id")
  description String?
  totalLp     Int      @default(0) @map("total_lp")
  usedLp      Int      @default(0) @map("used_lp")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  isActive    Boolean  @default(true) @map("is_active")
  projectId   String   @map("project_id")
  title       String   @default("")
  isDefault   Boolean  @default(false) @map("is_default")
  name        String
  epic        Epic?    @relation(fields: [epicId], references: [id])
  project     Order    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId])
  @@index([epicId])
  @@map("backlogs")
}

/// SLA rules per project — define max hours per priority level.
model SlaRule {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  priority  String
  maxHours  Int      @map("max_hours")
  createdAt DateTime @default(now()) @map("created_at")
  project   Order    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, priority])
  @@map("sla_rules")
}

/// A single work item. Core of the JIRA-like board.
model Task {
  id             String          @id @default(cuid())
  backlogId      String          @map("backlog_id")
  title          String
  description    String?
  lp             Int             @default(0)
  status         String          @default("backlog") @map("status")
  priority       String          @default("medium") @map("priority")
  assigneeId     String?         @map("assignee_id")
  branchName     String?         @map("branch_name")
  completedAt    DateTime?       @map("completed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  isActive       Boolean         @default(true) @map("is_active")
  mergeCommit    String?         @map("merge_commit")
  mergedAt       DateTime?       @map("merged_at")
  sortOrder      Int             @default(0) @map("sort_order")
  createdBy      String?         @map("created_by")
  estimatedHours Int?            @map("estimated_hours")
  externalId     String?         @map("external_id")
  slaDeadline    DateTime?       @map("sla_deadline")
  violated       Boolean         @default(false) @map("violated")
  bugNotes       BugNote[]
  commits        GitCommit[]
  lpAwards       LpAward[]
  tags           TaskTag[]
  violations     TaskViolation[]
  assignee       TeamMember?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  backlog        Backlog         @relation(fields: [backlogId], references: [id], onDelete: Cascade)

  @@index([backlogId])
  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

/// SLA violation record for a task.
model TaskViolation {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  type      String   @default("sla_breach") @map("type")
  revokedLp Int      @default(0) @map("revoked_lp")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_violations")
}

/// Labels/tags for filtering tasks.
model TaskTag {
  id     String @id @default(cuid())
  taskId String @map("task_id")
  name   String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, name])
  @@map("task_tags")
}

/// QA bug reports attached to a task.
model BugNote {
  id         String     @id @default(cuid())
  taskId     String     @map("task_id")
  severity   String     @default("medium") @map("severity")
  resolvedAt DateTime?  @map("resolved_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  authorId   String     @map("author_id")
  content    String
  status     String     @default("open") @map("status")
  author     TeamMember @relation("BugNoteAuthor", fields: [authorId], references: [id])
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("bug_notes")
}

/// Received from GitHub/GitLab webhooks. Auto-linked to task via branch naming convention.
model GitCommit {
  id           String   @id @default(cuid())
  taskId       String?  @map("task_id")
  sha          String   @unique
  message      String
  authorName   String   @map("author_name")
  authorEmail  String   @map("author_email")
  branch       String
  committedAt  DateTime @map("committed_at")
  lpAwarded    Boolean  @default(false) @map("lp_awarded")
  eventType    String   @default("push") @map("event_type")
  expAwarded   Boolean  @default(false) @map("exp_awarded")
  mergedToMain Boolean  @default(false) @map("merged_to_main")
  projectId    String   @map("project_id")
  receivedAt   DateTime @default(now()) @map("received_at")
  project      Order    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?    @relation(fields: [taskId], references: [id])

  @@index([projectId])
  @@index([taskId])
  @@map("git_commits")
}

/// LP/EXP awards earned by members. Pending → approved by PM/CEO.
model LpAward {
  id             String      @id @default(cuid())
  taskId         String?     @map("task_id")
  memberId       String      @map("member_id")
  lpAmount       Int         @default(0) @map("lp_amount")
  expAmount      Int         @default(0) @map("exp_amount")
  source         String      @default("manual") @map("source")
  status         String      @default("pending") @map("status")
  approvedBy     String?     @map("approved_by")
  rejectedReason String?     @map("rejected_reason")
  createdAt      DateTime    @default(now()) @map("created_at")
  approvedAt     DateTime?   @map("approved_at")
  projectId      String?     @map("project_id")
  approver       TeamMember? @relation("LpAwardApprover", fields: [approvedBy], references: [id])
  member         TeamMember  @relation("LpAwardMember", fields: [memberId], references: [id])
  project        Order?      @relation(fields: [projectId], references: [id])
  task           Task?       @relation(fields: [taskId], references: [id])

  @@index([projectId, memberId])
  @@index([taskId])
  @@index([memberId, status])
  @@index([status, createdAt])
  @@map("lp_awards")
}

/// Sales LP commission events — audit trail for sales commission credits.
model SalesCommissionEvent {
  id            String   @id @default(cuid())
  /// TeamMember.id — nhân viên nhận commission
  salesRepId    String   @map("sales_rep_id")
  /// Loại nguồn: "order" | "enrollment" | "media_booking"
  referenceType String   @map("reference_type")
  /// Order.id / Enrollment.id / ...
  referenceId   String   @map("reference_id")
  /// LP từ dịch vụ chính (10%)
  directLp      Int      @default(0) @map("direct_lp")
  /// LP từ addon (5%)
  addonLp       Int      @default(0) @map("addon_lp")
  /// Tổng LP đã credited
  totalLp       Int      @map("total_lp")
  /// Thời điểm credited
  paidAt        DateTime @default(now()) @map("paid_at")

  salesRep     TeamMember  @relation("SalesCommissionMember", fields: [salesRepId], references: [id])
  /// Back-ref to Order (nullable)
  order        Order?      @relation("SalesCommissionOrder", fields: [orderId], references: [id])
  orderId      String?     @map("order_id")
  /// Back-ref to Enrollment (nullable)
  enrollment   Enrollment? @relation("SalesCommissionEnrollment", fields: [enrollmentId], references: [id])
  enrollmentId String?     @map("enrollment_id")

  @@index([salesRepId])
  @@index([orderId])
  @@index([enrollmentId])
  @@index([referenceType, referenceId])
  @@index([paidAt])
  @@map("sales_commission_events")
}

/// Figma demo review workflow per project.
model FigmaDemo {
  id            String    @id @default(cuid())
  title         String
  figmaUrl      String    @map("figma_url")
  status        String    @default("pending") @map("status")
  clientEmail   String?   @map("client_email")
  clientToken   String?   @unique @map("client_token")
  sentAt        DateTime? @map("sent_at")
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  projectId     String    @map("project_id")
  rejectionNote String?   @map("rejection_note")
  versionHash   String?   @map("version_hash")
  project       Order     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("figma_demos")
}

/// Environment variable files per project/environment.
model EnvFile {
  id          String           @id @default(cuid())
  environment String           @map("environment")
  content     String
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  editedBy    String?          @map("edited_by")
  fileKey     String           @map("file_key")
  isActive    Boolean          @default(true) @map("is_active")
  projectId   String           @map("project_id")
  version     Int              @default(1)
  history     EnvFileHistory[]
  editor      TeamMember?      @relation("EnvFileEditor", fields: [editedBy], references: [id])
  project     Order            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, environment, fileKey])
  @@index([projectId])
  @@map("env_files")
}

/// Version history for EnvFile — created on every edit.
model EnvFileHistory {
  id           String   @id @default(cuid())
  envFileId    String   @map("env_file_id")
  content      String
  editedBy     String?  @map("edited_by")
  version      Int
  createdAt    DateTime @default(now()) @map("created_at")
  diffFromPrev Json?    @map("diff_from_prev")
  envFile      EnvFile  @relation(fields: [envFileId], references: [id], onDelete: Cascade)

  @@index([envFileId])
  @@map("env_file_histories")
}

/// SEO blog posts per project.
model BlogPost {
  id                 String        @id @default(cuid())
  title              String
  slug               String
  content            String?
  authorId           String        @map("author_id")
  coverImagePublicId String?       @map("cover_image_public_id")
  status             String        @default("draft") @map("status")
  seoTitle           String?       @map("seo_title")
  seoDesc            String?       @map("seo_desc")
  publishedAt        DateTime?     @map("published_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  coverImage         String?       @map("cover_image")
  excerpt            String?
  lpAwardedAt        DateTime?     @map("lp_awarded_at")
  lpEarned           Boolean       @default(false) @map("lp_earned")
  projectId          String        @map("project_id")
  contentEn          String?       @map("content_en")
  contentJa          String?       @map("content_ja")
  contentKo          String?       @map("content_ko")
  contentZh          String?       @map("content_zh")
  excerptEn          String?       @map("excerpt_en")
  excerptJa          String?       @map("excerpt_ja")
  excerptKo          String?       @map("excerpt_ko")
  excerptZh          String?       @map("excerpt_zh")
  seoDescEn          String?       @map("seo_desc_en")
  seoDescJa          String?       @map("seo_desc_ja")
  seoDescKo          String?       @map("seo_desc_ko")
  seoDescZh          String?       @map("seo_desc_zh")
  seoTitleEn         String?       @map("seo_title_en")
  seoTitleJa         String?       @map("seo_title_ja")
  seoTitleKo         String?       @map("seo_title_ko")
  seoTitleZh         String?       @map("seo_title_zh")
  titleEn            String?       @map("title_en")
  titleJa            String?       @map("title_ja")
  titleKo            String?       @map("title_ko")
  titleZh            String?       @map("title_zh")
  /// YouTube / Vimeo embed URL for video posts
  videoUrl           String?       @map("video_url")
  /// Canonical URL for duplicate content (SEO)
  canonicalUrl       String?       @map("canonical_url")
  /// External links cited in the article (JSON: [{url, label}])
  backlinks          String?       @map("backlinks")
  author             TeamMember    @relation(fields: [authorId], references: [id])
  project            Order         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tags               BlogPostTag[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([authorId])
  @@index([status, publishedAt])
  @@index([slug])
  @@map("blog_posts")
}

/// Tag phân loại bài viết blog (VD: "SEO", "Web Design", "Marketing")
model BlogTag {
  id        String        @id @default(cuid())
  key       String        @unique @map("tag_key") // "seo", "web-design", "marketing"
  name      String // "SEO"
  nameEn    String?       @map("name_en")
  nameJa    String?       @map("name_ja")
  nameKo    String?       @map("name_ko")
  nameZh    String?       @map("name_zh")
  color     String        @default("#3B82F6") // màu hiển thị
  sortOrder Int           @default(0) @map("sort_order")
  posts     BlogPostTag[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("blog_tags")
}

/// Join table: nhiều tag cho mỗi bài viết
model BlogPostTag {
  id         String   @id @default(cuid())
  blogPostId String   @map("blog_post_id")
  tagId      String   @map("tag_id")
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag        BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([blogPostId, tagId])
  @@index([tagId])
  @@map("blog_post_tags")
}

/// Client-facing project portal access token.
model ProjectPortalToken {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  token     String    @unique @map("access_token")
  label     String    @default("Client Portal")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  project   Order     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([token])
  @@map("project_portal_tokens")
}

/// Social media post linked to an order/project.
model SocialPost {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  platform    String    @map("platform")
  content     String?
  mediaUrls   Json      @default("[]") @map("media_urls")
  scheduledAt DateTime? @map("scheduled_at")
  publishedAt DateTime? @map("published_at")
  status      String    @default("draft") @map("status")
  postUrl     String?   @map("post_url")
  publishedBy String?   @map("published_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  project     Order     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("social_posts")
}

/// Tracks deployment history per project environment.
model Deployment {
  id            String    @id @default(cuid())
  projectId     String    @map("project_id")
  environment   String    @map("environment")
  platform      String    @default("manual") @map("platform")
  deployUrl     String?   @map("deploy_url")
  commitSha     String?   @map("commit_sha")
  status        String    @default("pending") @map("status")
  deployedAt    DateTime? @map("deployed_at")
  deployedBy    String?   @map("deployed_by")
  gscVerified   Boolean   @default(false) @map("gsc_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  deployHookUrl String?   @map("deploy_hook_url")
  project       Order     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("deployments")
}

/// Google Search Console SEO metrics per project page.
model GscMetric {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  pageUrl     String   @map("page_url")
  keyword     String   @default("")
  impressions Int      @default(0) @map("impressions")
  clicks      Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  dataDate    DateTime @default(now()) @map("data_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project     Order    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([dataDate])
  @@map("gsc_metrics")
}

/// Project handover checklist delivered to client.
model HandoverPackage {
  id            String    @id @default(cuid())
  projectId     String    @map("project_id")
  status        String    @default("draft") @map("status")
  handoverDate  DateTime? @map("handover_date")
  items         Json      @default("[]") @map("items")
  notes         String?
  /// Figma source file URL saved when client approves final design
  figmaUrl      String?   @map("figma_url")
  /// GitHub repository URL with source code
  githubUrl     String?   @map("github_url")
  /// Deployed website URL
  deploymentUrl String?   @map("deployment_url")
  /// Scope summary: { features: string[], pointCount: number, customRequests: string[] }
  scope         Json?     @map("scope")
  /// Customer notes submitted during handover review
  customerNotes String?   @map("customer_notes")
  /// Internal admin/PM notes
  adminNotes    String?   @map("admin_notes")
  deliveredBy   String?   @map("delivered_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  project       Order     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("handover_packages")
}

/// Daily standup report per team member per project.
model DailyStandup {
  id            String     @id @default(cuid())
  projectId     String     @map("project_id")
  memberId      String     @map("member_id")
  date          DateTime   @map("date")
  yesterdayDone String?    @map("yesterday_done")
  todayPlan     String?    @map("today_plan")
  blockers      String?
  createdAt     DateTime   @default(now()) @map("created_at")
  member        TeamMember @relation(fields: [memberId], references: [id])
  project       Order      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId, date])
  @@index([projectId])
  @@index([memberId])
  @@map("daily_standups")
}

/// Maintenance contract per project — renewal tracking + auto-renewal reminders.
model MaintenanceContract {
  id                  String   @id @default(cuid())
  projectId           String   @map("project_id")
  title               String
  price               Int      @map("price")
  billingCycle        String   @default("monthly")
  startDate           DateTime @map("start_date")
  endDate             DateTime @map("end_date")
  autoRenew           Boolean  @default(false) @map("auto_renew")
  status              String   @default("active")
  renewalReminderSent Boolean  @default(false) @map("renewal_reminder_sent")
  note                String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  project             Order    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([endDate])
  @@map("maintenance_contracts")
}

/// Instructor profile for internal/external teaching staff.
model Instructor {
  id             String      @id @default(cuid())
  memberId       String?     @unique @map("member_id")
  userId         String?     @unique @map("user_id")
  name           String
  bio            String?
  bioEn          String?     @map("bio_en")
  bioJa          String?     @map("bio_ja")
  bioKo          String?     @map("bio_ko")
  bioZh          String?     @map("bio_zh")
  email          String?
  phone          String?
  specialties    String[]
  rating         Float       @default(0)
  totalStudents  Int         @default(0) @map("total_students")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  avatar         String?     @map("avatar")
  avatarPublicId String?     @map("avatar_public_id")
  courses        Course[]
  member         TeamMember? @relation(fields: [memberId], references: [id])
  user           User?       @relation("InstructorToUser", fields: [userId], references: [id])

  @@index([isActive])
  @@map("instructors")
}

/// Course definition (1:1 or group).
model Course {
  id                 String       @id @default(cuid())
  title              String
  titleVi            String       @map("title_vi")
  titleEn            String?      @map("title_en")
  titleJa            String?      @map("title_ja")
  titleKo            String?      @map("title_ko")
  titleZh            String?      @map("title_zh")
  description        String?
  descriptionVi      String?      @map("description_vi")
  descriptionEn      String?      @map("description_en")
  descriptionJa      String?      @map("description_ja")
  descriptionKo      String?      @map("description_ko")
  descriptionZh      String?      @map("description_zh")
  type               String       @default("group")
  instructorId       String       @map("instructor_id")
  instructorType     String       @default("instructor") @map("instructor_type")
  instructorMemberId String?      @map("instructor_member_id")
  instructorUserId   String?      @map("instructor_user_id")
  lpReward           Int          @default(0) @map("lp_reward")
  maxStudents        Int          @default(1) @map("max_students")
  durationWeeks      Int          @default(4) @map("duration_weeks")
  status             String       @default("draft")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  price              Int          @default(0)
  thumbnail          String?      @map("thumbnail")
  thumbnailPublicId  String?      @map("thumbnail_public_id")
  instructor         Instructor   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  instructorMember   TeamMember?  @relation("CourseToInstructorMember", fields: [instructorMemberId], references: [id])
  instructorUser     User?        @relation("CourseToInstructorUser", fields: [instructorUserId], references: [id])
  enrollments        Enrollment[]
  lessons            Lesson[]

  @@index([status])
  @@index([instructorId])
  @@index([instructorMemberId])
  @@index([instructorUserId])
  @@map("courses")
}

/// Lesson content in a course.
model Lesson {
  id              String            @id @default(cuid())
  courseId        String            @map("course_id")
  title           String
  titleVi         String            @map("title_vi")
  titleEn         String?           @map("title_en")
  titleJa         String?           @map("title_ja")
  titleKo         String?           @map("title_ko")
  titleZh         String?           @map("title_zh")
  orderIndex      Int               @default(0) @map("order_index")
  content         String?
  durationMinutes Int               @default(60) @map("duration_minutes")
  isPublished     Boolean           @default(false) @map("is_published")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  attendances     Attendance[]
  feedbacks       Feedback[]
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses      StudentProgress[]
  exercises       LessonExercise[]
  comments        LessonComment[]

  @@index([courseId, orderIndex])
  @@map("lessons")
}

/// Enrollment of a student into a course (student can be a User or TeamMember).
model Enrollment {
  id                    String                 @id @default(cuid())
  courseId              String                 @map("course_id")
  userId                String?                @map("user_id")
  memberId              String?                @map("member_id")
  assigneeLpPercent     Int                    @default(100) @map("assignee_lp_percent")
  paidAmount            Int                    @default(0) @map("paid_amount")
  enrolledAt            DateTime               @default(now()) @map("enrolled_at")
  status                String                 @default("active")
  completedLessons      Json?                  @default("[]") @map("completed_lessons")
  progressPercent       Int                    @default(0) @map("progress_percent")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  attendances           Attendance[]
  payments              EduPayment[]
  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member                TeamMember?            @relation("EnrollmentTeamMember", fields: [memberId], references: [id])
  user                  User?                  @relation("EnrollmentUser", fields: [userId], references: [id])
  feedbacks             Feedback[]
  progresses            StudentProgress[]
  salesRepId            String?                @map("sales_rep_id")
  /// Whether academy commission has been credited
  commissionPaid        Boolean                @default(false) @map("commission_paid")
  /// When commission was credited
  commissionPaidAt      DateTime?              @map("commission_paid_at")
  /// Sales commission events for this enrollment
  salesCommissionEvents SalesCommissionEvent[] @relation("SalesCommissionEnrollment")

  @@index([courseId])
  @@index([userId])
  @@index([memberId])
  @@index([status])
  @@map("enrollments")
}

/// Payment record for EDU enrollments (tuition transactions).
model EduPayment {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  amount       Int
  method       String?
  note         String?
  status       String     @default("completed")
  confirmedBy  String?    @map("confirmed_by")
  confirmedAt  DateTime   @default(now()) @map("confirmed_at")
  lpAwarded    Int        @default(0) @map("lp_awarded")
  instructorLp Int        @default(0) @map("instructor_lp")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, createdAt])
  @@index([status])
  @@map("edu_payments")
}

/// A staff member redeems LP to claim an AddonService reward.
model Attendance {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  lessonId     String     @map("lesson_id")
  status       String     @default("present")
  checkedInAt  DateTime?  @map("checked_in_at")
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
  @@index([status])
  @@map("attendances")
}

/// Student feedback for course/lesson quality.
model Feedback {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  lessonId     String?    @map("lesson_id")
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson?    @relation(fields: [lessonId], references: [id])

  @@index([enrollmentId])
  @@index([lessonId])
  @@index([rating])
  @@map("feedbacks")
}

/// Student lesson code exercise submissions.
model LessonExercise {
  id        String   @id @default(cuid())
  lessonId  String   @map("lesson_id")
  userId    String?  @map("user_id")
  memberId  String?  @map("member_id")
  code      String
  language  String   @default("javascript")
  output    String?
  passed    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([userId])
  @@index([memberId])
  @@map("lesson_exercises")
}

/// Lesson comment from a student.
model LessonComment {
  id        String   @id @default(cuid())
  lessonId  String   @map("lesson_id")
  userId    String?  @map("user_id")
  memberId  String?  @map("member_id")
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([userId])
  @@index([memberId])
  @@map("lesson_comments")
}

/// Student lesson completion progression.
model StudentProgress {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  lessonId     String     @map("lesson_id")
  completedAt  DateTime?  @map("completed_at")
  quizScore    Int?       @map("quiz_score")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
  @@map("student_progress")
}

/// A staff member redeems LP to claim an AddonService reward.
model LpRedemption {
  id         String       @id @default(cuid())
  memberId   String       @map("member_id")
  addonId    String       @map("addon_id")
  lpCost     Int
  /// *
  ///    * For recurring items: expiry date; for one-time, null
  expiresAt  DateTime?    @map("expires_at")
  status     String       @default("active")
  redeemedAt DateTime?    @map("redeemed_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  quantity   Int          @default(1)
  addon      AddonService @relation(fields: [addonId], references: [id])
  member     TeamMember   @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([addonId])
  @@index([status])
  @@map("lp_redemptions")
}

/// Immutable ledger entry for every LP movement affecting a staff member.
/// Sources: award (PM approves LP), transfer (internal transfer), spend (redemption),
/// adjust (admin manual adjustment), expire (auto-expired LP).
model LpTransaction {
  id             String      @id @default(cuid())
  memberId       String      @map("member_id")
  /// *
  ///    * Amount in absolute LP. Positive = credit, negative = debit.
  amount         Int
  /// *
  ///    * Running balance after this transaction (for audit / consistency).
  balanceAfter   Int         @default(0) @map("balance_after")
  /// *
  ///    * Transaction type drives UI label + validation rules.
  type           String
  status         String      @default("completed")
  /// *
  ///    * human-readable description
  description    String?
  source         String      @default("manual")
  /// *
  ///    * ID of the originating record (LpAward.id, LpTransaction.id for transfer, etc.)
  referenceId    String?     @map("reference_id")
  referenceType  String?     @map("reference_type")
  /// *
  ///    * For transfers: counterparty member
  counterpartyId String?     @map("counterparty_id")
  /// *
  ///    * Fee charged on this transaction (e.g. transfer fee)
  fee            Int         @default(0)
  createdBy      String?     @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at")
  counterparty   TeamMember? @relation("LpTransactionCounterparty", fields: [counterpartyId], references: [id])
  creator        TeamMember? @relation("LpTransactionCreator", fields: [createdBy], references: [id])
  member         TeamMember  @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([memberId, createdAt])
  @@index([memberId, type])
  @@index([referenceId, referenceType])
  @@index([status])
  @@map("lp_transactions")
}

/// *
///  * Tracks media booking lifecycle from customer request to final delivery.
///  * Status flow: pending → confirmed → in_progress → delivered → approved | rejected
///  * - customer requests media service
///  * - admin confirms booking + assigns media staff
///  * - media team delivers assets
///  * - customer reviews + approves or requests revision
model MediaBooking {
  id              String          @id @default(cuid())
  /// * Human-readable booking number, e.g. "MBK-XXXXXXXXXXXX"
  bookingNumber   String          @unique @map("booking_number")
  /// * FK → ServicePackage.id (which media package was ordered)
  packageId       String?         @map("package_id")
  /// * FK → Order.id (links to the parent order if applicable)
  orderId         String?         @map("order_id")
  customerName    String          @map("customer_name")
  customerEmail   String          @map("customer_email")
  customerPhone   String?         @map("customer_phone")
  companyName     String?         @map("company_name")
  /// * Booking type: event | product | corporate | social | custom
  bookingType     String          @default("event") @map("booking_type")
  /// * Short title / event name
  title           String
  /// * Full brief from customer
  requirements    String?         @map("requirements")
  /// * Admin notes (internal)
  note            String?         @map("note")
  /// * Delivery deadline
  deadline        DateTime?       @map("deadline")
  /// * Booking status
  status          String          @default("pending") @map("status")
  /// * Payment status
  paymentStatus   String          @default("unpaid") @map("payment_status")
  /// * Agreed price at time of booking
  totalAmount     Int?            @map("total_amount")
  /// * Amount paid so far
  paidAmount      Int             @default(0) @map("paid_amount")
  /// * Media assets delivered — JSON array of Cloudinary URLs
  deliveredAssets Json            @default("[]") @map("delivered_assets")
  /// * Revision notes from customer or internal review
  revisionNotes   String?         @map("revision_notes")
  /// * When assets were delivered to customer
  deliveredAt     DateTime?       @map("delivered_at")
  /// * When customer approved final delivery
  approvedAt      DateTime?       @map("approved_at")
  /// * Who approved (admin user id)
  approvedBy      String?         @map("approved_by")
  /// * Who rejected (admin user id)
  rejectedBy      String?         @map("rejected_by")
  /// * When rejected
  rejectedAt      DateTime?       @map("rejected_at")
  /// * Assigned media team member id
  assignedTo      String?         @map("assigned_to")
  /// * FK → TeamMember.id
  teamMemberId    String?         @map("team_member_id")
  /// * Whether this project is featured on the media showcase page
  isFeatured      Boolean         @default(false) @map("is_featured")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  package         ServicePackage? @relation(fields: [packageId], references: [id])
  teamMember      TeamMember?     @relation(fields: [teamMemberId], references: [id])
  order           Order?          @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([teamMemberId])
  @@index([deadline])
  @@map("media_bookings")
}

// ── Media Showcase: Testimonials ───────────────────────────────────────────────
/// Client testimonial specific to media production services.
/// Separate from the general `Testimonial` model to keep media-specific data
/// (e.g. linked booking, project type) isolated.
model MediaTestimonial {
  id             String        @id @default(cuid())
  customerName   String        @map("customer_name")
  customerCompany String?      @map("customer_company")
  customerAvatar String?       @map("customer_avatar")
  /// Star rating 1-5
  rating         Int           @default(5)
  /// Review text (Vietnamese — default)
  text           String
  textEn         String?       @map("text_en")
  textJa         String?       @map("text_ja")
  textKo         String?       @map("text_ko")
  textZh         String?       @map("text_zh")
  /// Media booking type this review relates to: event | product | corporate | social | custom
  projectType    String?       @map("project_type")
  /// Optional link to the booking this review belongs to
  mediaBookingId String?       @map("media_booking_id")
  isActive       Boolean       @default(true) @map("is_active")
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("media_testimonials")
}

// ── Media Showcase: Stories (behind-the-scenes) ────────────────────────────────
/// Behind-the-scenes blog post from the media team.
/// Covers topics like: how we found the perfect shooting spot, production
/// challenges, tips & tricks, and "making of" stories.
model MediaStory {
  id                 String      @id @default(cuid())
  title              String
  titleEn            String?     @map("title_en")
  titleJa            String?     @map("title_ja")
  titleKo            String?     @map("title_ko")
  titleZh            String?     @map("title_zh")
  slug               String      @unique
  /// Rich-text content (HTML)
  content            String?
  contentEn          String?     @map("content_en")
  contentJa          String?     @map("content_ja")
  contentKo          String?     @map("content_ko")
  contentZh          String?     @map("content_zh")
  /// Short excerpt for cards (2-3 lines)
  excerpt            String?
  excerptEn          String?     @map("excerpt_en")
  excerptJa          String?     @map("excerpt_ja")
  excerptKo          String?     @map("excerpt_ko")
  excerptZh          String?     @map("excerpt_zh")
  /// Cover image (Cloudinary URL)
  coverImage         String?     @map("cover_image")
  coverImagePublicId String?     @map("cover_image_public_id")
  /// FK → TeamMember who authored this story
  authorId           String      @map("author_id")
  author             TeamMember  @relation("MediaStoryAuthor", fields: [authorId], references: [id])
  /// Optional link to the media booking this story is about
  mediaBookingId     String?     @map("media_booking_id")
  /// draft | published | archived
  status             String      @default("draft")
  publishedAt        DateTime?   @map("published_at")
  /// SEO fields
  seoTitle           String?     @map("seo_title")
  seoDesc            String?     @map("seo_desc")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("media_stories")
}

// ── Rank Effects System ────────────────────────────────────────────────────────
model RankEffect {
  id              String                 @id @default(cuid())
  name            String
  description     String
  /// * Effect type: particle | glow | border | aura | trail | shimmer | fire | holographic
  type            String
  /// * Rarity: common | rare | epic | legendary
  rarity          String
  icon            String
  color           String
  /// * Minimum rank to unlock: iron | bronze | silver | gold | platinum | ruby | diamond
  minRank         String                 @map("min_rank")
  minLevel        Int                    @map("min_level")
  maxLevel        Int?                   @map("max_level")
  isEnabled       Boolean                @default(true) @map("is_enabled")
