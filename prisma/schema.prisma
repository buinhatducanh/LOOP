// ─── EDU SYSTEM (M14) ─────────────────────────────────────────────────────────

/// Instructor profile for internal/external teaching staff.
model Instructor {
  id            String   @id @default(cuid())
  memberId      String?  @unique @map("member_id") // optional link to TeamMember
  userId        String?  @unique @map("user_id") // optional link to User
  name          String
  bio           String?  @db.Text
  email         String?
  phone         String?
  specialties   String[] // e.g. ["frontend", "seo", "project-management"]
  rating        Float    @default(0)
  totalStudents Int      @default(0) @map("total_students")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  member  TeamMember? @relation(fields: [memberId], references: [id])
  user    User?       @relation("InstructorToUser", fields: [userId], references: [id])
  courses Course[]

  @@index([isActive])
  @@map("instructors")
}

/// Course definition (1:1 or group).
model Course {
  id                 String   @id @default(cuid())
  title              String
  titleVi            String   @map("title_vi")
  description        String?  @db.Text
  descriptionVi      String?  @map("description_vi") @db.Text
  type               String   @default("group") // "1:1" | "group"
  instructorId       String   @map("instructor_id")
  instructorType     String   @default("instructor") @map("instructor_type") // instructor | member | user
  instructorMemberId String?  @map("instructor_member_id")
  instructorUserId   String?  @map("instructor_user_id")
  price              Int      @default(0)
  lpReward           Int      @default(0) @map("lp_reward") // usually 10% of price
  maxStudents        Int      @default(1) @map("max_students")
  durationWeeks      Int      @default(4) @map("duration_weeks")
  status             String   @default("draft") // draft | published | archived
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  instructor       Instructor   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  instructorMember TeamMember?  @relation("CourseToInstructorMember", fields: [instructorMemberId], references: [id], onDelete: SetNull)
  instructorUser   User?        @relation("CourseToInstructorUser", fields: [instructorUserId], references: [id], onDelete: SetNull)
  lessons          Lesson[]
  enrollments      Enrollment[]

  @@index([status])
  @@index([instructorId])
  @@index([instructorMemberId])
  @@index([instructorUserId])
  @@map("courses")
}

/// Lesson content in a course.
model Lesson {
  id              String   @id @default(cuid())
  courseId        String   @map("course_id")
  title           String
  titleVi         String   @map("title_vi")
  orderIndex      Int      @default(0) @map("order_index")
  content         String?  @db.Text
  durationMinutes Int      @default(60) @map("duration_minutes")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  feedbacks   Feedback[]
  progresses  StudentProgress[]

  @@index([courseId, orderIndex])
  @@map("lessons")
}

/// Enrollment of a student into a course (student can be a User or TeamMember).
model Enrollment {
  id                String   @id @default(cuid())
  courseId          String   @map("course_id")
  userId            String?  @map("user_id")
  memberId          String?  @map("member_id")
  assigneeLpPercent Int      @default(100) @map("assignee_lp_percent")
  paidAmount        Int      @default(0) @map("paid_amount")
  enrolledAt        DateTime @default(now()) @map("enrolled_at")
  status            String   @default("active") // active | completed | cancelled
  completedLessons  Json?    @default("[]") @map("completed_lessons")
  progressPercent   Int      @default(0) @map("progress_percent")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User?             @relation("EnrollmentUser", fields: [userId], references: [id])
  member      TeamMember?       @relation("EnrollmentTeamMember", fields: [memberId], references: [id])
  attendances Attendance[]
  feedbacks   Feedback[]
  progresses  StudentProgress[]
  payments    EduPayment[]

  @@index([courseId])
  @@index([userId])
  @@index([memberId])
  @@index([status])
  @@map("enrollments")
}

/// Payment record for EDU enrollments (tuition transactions).
model EduPayment {
  id           String   @id @default(cuid())
  enrollmentId String   @map("enrollment_id")
  amount       Int
  method       String? // cash | bank_transfer | card | momo | etc.
  note         String?  @db.Text
  status       String   @default("completed") // pending | completed | failed | refunded
  confirmedBy  String?  @map("confirmed_by") // User.id
  confirmedAt  DateTime @default(now()) @map("confirmed_at")
  lpAwarded    Int      @default(0) @map("lp_awarded")
  instructorLp Int      @default(0) @map("instructor_lp")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, createdAt])
  @@index([status])
  @@map("edu_payments")
}

// ─── LP Redemption ────────────────────────────────────────────────────────────

/// A staff member redeems LP to claim an AddonService reward.
model Attendance {
