  serviceKey String?  @map("service_key")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  features  Feature[]

  @@map("feature_groups")
}

model Feature {
  id          String           @id @default(cuid())
  groupId     String           @map("group_id")
  featureName String           @map("feature_name")
  description String?
  logicLevel  String           @default("Medium") @map("logic_level")
  isRequired  Boolean          @default(false) @map("is_required")
  sortOrder   Int              @default(0) @map("sort_order")
  isActive    Boolean          @default(true) @map("is_active")
  /// Danh mục hiển thị trên public page (VD: "Giao diện", "Tính năng cốt lõi")
  category    String           @default("Khác") @map("category")
  /// Giá extra phải trả thêm nếu tính năng không nằm trong gói (VNĐ)
  extraPrice  Int              @default(0) @map("extra_price")
