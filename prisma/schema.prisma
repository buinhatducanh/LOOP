// ─── LP Redemption ────────────────────────────────────────────────────────────

/// A staff member redeems LP to claim an AddonService reward.
model LpRedemption {
  id         String    @id @default(cuid())
  memberId   String    @map("member_id") // FK → TeamMember.id
  addonId    String    @map("addon_id") // FK → AddonService.id
  lpCost     Int // LP deducted at time of redemption (snapshot; per-unit cost)
  quantity   Int       @default(1) // Number of items redeemed
  /**
   * For recurring items: expiry date; for one-time, null
   */
  expiresAt  DateTime? @map("expires_at")
  status     String    @default("active") // active | redeemed | expired | cancelled
  redeemedAt DateTime? @map("redeemed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  member TeamMember   @relation(fields: [memberId], references: [id])
  addon  AddonService @relation(fields: [addonId], references: [id])

  @@index([memberId])
  @@index([addonId])
  @@index([status])
  @@map("lp_redemptions")
}

// ─── LP Transaction Ledger ────────────────────────────────────────────────────

/// Immutable ledger entry for every LP movement affecting a staff member.
/// Sources: award (PM approves LP), transfer (internal transfer), spend (redemption),
/// adjust (admin manual adjustment), expire (auto-expired LP).
model LpTransaction {
  id             String   @id @default(cuid())
  memberId       String   @map("member_id") // FK → TeamMember.id
  /**
   * Amount in absolute LP. Positive = credit, negative = debit.
   */
  amount         Int
  /**
   * Running balance after this transaction (for audit / consistency).
   */
  balanceAfter   Int      @default(0) @map("balance_after")
  /**
   * Transaction type drives UI label + validation rules.
   */
  type           String // award | transfer_sent | transfer_received | spend | adjust | expire
  status         String   @default("completed") // pending | completed | failed | cancelled
  /**
   * human-readable description
   */
  description    String?
  source         String   @default("manual") // Same as LpAward.source (manual|task_done|commit_merge|seo_published|transfer|spend|admin)
  /**
   * ID of the originating record (LpAward.id, LpTransaction.id for transfer, etc.)
   */
  referenceId    String?  @map("reference_id")
  referenceType  String?  @map("reference_type") // LpAward | LpTransaction | LpRedemption | Order | null
  /**
   * For transfers: counterparty member
   */
  counterpartyId String?  @map("counterparty_id") // FK → TeamMember.id
  /**
   * Fee charged on this transaction (e.g. transfer fee)
   */
  fee            Int      @default(0)
  createdBy      String?  @map("created_by") // FK → TeamMember.id (who made the entry; null = system)
  createdAt      DateTime @default(now()) @map("created_at")

  member       TeamMember  @relation(fields: [memberId], references: [id])
  counterparty TeamMember? @relation("LpTransactionCounterparty", fields: [counterpartyId], references: [id])
  creator      TeamMember? @relation("LpTransactionCreator", fields: [createdBy], references: [id])

  @@index([memberId])
  @@index([memberId, createdAt])
  @@index([memberId, type])
  @@index([referenceId, referenceType])
  @@index([status])
  @@map("lp_transactions")
}

// ─── Media Booking ─────────────────────────────────────────────────────────────

/**
 * Tracks media booking lifecycle from customer request to final delivery.
 * Status flow: pending → confirmed → in_progress → delivered → approved | rejected
 * - customer requests media service
 * - admin confirms booking + assigns media staff
 * - media team delivers assets
 * - customer reviews + approves or requests revision
 */
model MediaBooking {
  id               String    @id @default(cuid())
  /** Human-readable booking number, e.g. "MBK-XXXXXXXXXXXX" */
  bookingNumber    String    @unique @map("booking_number")
  /** FK → ServicePackage.id (which media package was ordered) */
  packageId        String?   @map("package_id")
  package          ServicePackage? @relation(fields: [packageId], references: [id])
  /** FK → Order.id (links to the parent order if applicable) */
  orderId          String?   @map("order_id")
  customerName     String    @map("customer_name")
  customerEmail    String    @map("customer_email")
  customerPhone    String?   @map("customer_phone")
  companyName      String?   @map("company_name")
  /** Booking type: event | product | corporate | social | custom */
  bookingType      String    @default("event") @map("booking_type")
  /** Short title / event name */
  title            String
  /** Full brief from customer */
  requirements     String?   @db.Text @map("requirements")
  /** Admin notes (internal) */
  note             String?   @db.Text @map("note")
  /** Delivery deadline */
  deadline         DateTime? @map("deadline")
  /** Booking status */
  status           String    @default("pending") @map("status")
  // pending       = awaiting admin confirmation
  // confirmed     = confirmed, awaiting assets
  // in_progress   = media team working on it
  // delivered    = assets sent to customer for review
  // approved     = customer approved final delivery
  // rejected     = customer rejected, needs revision
  // cancelled    = cancelled before delivery

  /** Payment status */
  paymentStatus    String    @default("unpaid") @map("payment_status")
  // unpaid | partial | paid | refunded

  /** Agreed price at time of booking */
  totalAmount      Int?      @map("total_amount")
  /** Amount paid so far */
  paidAmount       Int       @default(0) @map("paid_amount")

  /** Media assets delivered — JSON array of Cloudinary URLs */
  deliveredAssets  Json      @default("[]") @map("delivered_assets")
  /** Revision notes from customer or internal review */
  revisionNotes    String?   @db.Text @map("revision_notes")

  /** When assets were delivered to customer */
  deliveredAt      DateTime? @map("delivered_at")
  /** When customer approved final delivery */
  approvedAt       DateTime? @map("approved_at")
  /** Who approved (admin user id) */
  approvedBy       String?   @map("approved_by")
  /** Who rejected (admin user id) */
  rejectedBy       String?   @map("rejected_by")
  /** When rejected */
  rejectedAt       DateTime? @map("rejected_at")

  /** Assigned media team member id */
  assignedTo       String?   @map("assigned_to")
  /** FK → TeamMember.id */
  teamMemberId     String?   @map("team_member_id")
  teamMember      TeamMember? @relation(fields: [teamMemberId], references: [id])

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // ── Indexes ───────────────────────────────────────────────────────────
  @@index([status])
  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([teamMemberId])
  @@index([deadline])
  @@map("media_bookings")
}
