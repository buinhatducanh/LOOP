  thumbnail   String? // Ảnh thumbnail
  title       String? // Tiêu đề video
  description String? // Mô tả ngắn
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("home_videos")
}

// ─── DUAL SERVICE MODEL ─────────────────────────────────────────

// Kho tính năng mở rộng (Feature Catalog) — admin quản lý
// Dùng chung cho cả 2 luồng: Web Gói (gắn cứng) & Web Thiết Kế (khách chọn)
model ServiceAttribute {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameVi        String   @map("name_vi")
  description   String?
  descriptionVi String?  @map("description_vi")
  category      String // VD: "performance", "security", "ecommerce", "seo"
  categoryVi    String   @map("category_vi")
  icon          String?
  price         Int      @default(0) // Giá khi khách chọn riêng lẻ (Custom flow)
  isRequired    Boolean  @default(false) @map("is_required") // Bắt buộc cho mọi dự án
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // ── Tier & XP (Platform Architecture) ──
  tier     String             @default("basic") // "basic" | "advanced"
  xpPoints Int                @default(0) @map("xp_points") // Điểm XP (chỉ advanced > 0)
  parentId String?            @map("parent_id") // Quan hệ cha-con (mutual exclusion)
  parent   ServiceAttribute?  @relation("FeatureHierarchy", fields: [parentId], references: [id])
  children ServiceAttribute[] @relation("FeatureHierarchy")

  // Relations
  templateAttributes WebTemplateAttribute[]
  orderAttributes    OrderAttribute[]

  @@index([tier, isActive])
  @@index([category, tier])
  @@index([parentId])
  @@map("service_attributes")
}

// Kho giao diện (Template Gallery) — Luồng "Web Gói"
model WebTemplate {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameVi        String   @map("name_vi")
  description   String?
  descriptionVi String?  @map("description_vi")
  category      String // VD: "landing-page", "ecommerce", "portfolio", "corporate"
  categoryVi    String   @map("category_vi")
  thumbnail     String // URL ảnh thumbnail
  screenshots   String[] // Ảnh chụp màn hình chi tiết
  demoUrl       String   @map("demo_url") // Link demo thực tế (Vercel, etc.)
  price         Int // Giá trọn gói
  originalPrice Int?     @map("original_price") // Giá gốc (nếu muốn hiển thị giảm giá)
  currency      String   @default("VND")
  technologies  String[] // VD: ["Next.js", "TailwindCSS", "PostgreSQL"]
  deliveryTime  String   @map("delivery_time") // VD: "3-5 ngày"
  highlighted   Boolean  @default(false) // Nổi bật
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // ── Level system (Platform Architecture) ──
  level        Int     @default(1) // Cấp độ gói: 1=Cơ bản, 2=Trung cấp, 3=Nâng cao, 4=Premium
  levelLabel   String? @map("level_label") // "Basic", "Pro", "Enterprise"
  levelLabelVi String? @map("level_label_vi") // "Cơ bản", "Chuyên nghiệp", "Doanh nghiệp"

  // Relations — Các tính năng đi kèm (gắn cứng)
  bundledAttributes WebTemplateAttribute[]
  orders            Order[]

  @@index([level, isActive])
  @@index([category, isActive])
  @@map("web_templates")
}

// Bảng nối: Template <-> Attribute (tính năng gắn cứng vào gói)
model WebTemplateAttribute {
  id          String           @id @default(cuid())
  templateId  String           @map("template_id")
  template    WebTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attributeId String           @map("attribute_id")
  attribute   ServiceAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([templateId, attributeId])
  @@map("web_template_attributes")
}

// Bảng nối: Order <-> Attribute (tính năng khách chọn riêng - Custom flow)
model OrderAttribute {
  id           String           @id @default(cuid())
  orderId      String           @map("order_id")
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attributeId  String           @map("attribute_id")
  attribute    ServiceAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  priceAtOrder Int              @map("price_at_order") // Snapshot giá tại thời điểm đặt hàng

  @@unique([orderId, attributeId])
  @@map("order_attributes")
}

// ─── REFERRAL SYSTEM ───────────────────────────────────────────────────────────

/// A unique referral code assigned to a staff member (referrer).
/// Codes are created by admins; each member can have multiple active codes per campaign.
model ReferralCode {
  id         String    @id @default(cuid())
  /**
   * Unique human-readable code, e.g. "THANGDEV", "LOOP-AI-2026"
   */
  code       String    @unique @map("code")
  /**
   * Display name, e.g. "Thang Dev - 2026 Campaign"
   */
  name       String
  /**
   * Staff member who earns LP when referrals convert
   */
  memberId   String    @map("member_id") // FK → TeamMember.id
  /**
   * Optional campaign label, e.g. "2026-Q1", "Summer Promo"
   */
  campaign   String?
  /**
   * VND revenue threshold for this tier. Referrer LP = floor(totalRevenue × tierRate).
   */
  minRevenue Int       @default(0) @map("min_revenue")
  maxRevenue Int?      @map("max_revenue") // null = uncapped
  /**
   * LP reward rate for this tier. Example: 0.10 = 10% of referral revenue in LP for referrer.
   */
  lpRate     Float     @default(0.05) @map("lp_rate")
  /**
   * Number of uses / max uses (null = unlimited).
   */
  useCount   Int       @default(0) @map("use_count")
  maxUses    Int?      @map("max_uses")
  isActive   Boolean   @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  member   TeamMember         @relation(fields: [memberId], references: [id])
  leads    SalesLead[]        @relation("ReferralCodeLeads")
  orders   Order[]            @relation("ReferralCodeOrders")
  tracking ReferralTracking[]

  @@index([memberId])
  @@index([campaign])
  @@map("referral_codes")
}

/// Tracks every click / signup / order attributed to a referral code.
model ReferralTracking {
  id             String   @id @default(cuid())
  referralCodeId String   @map("referral_code_id") // FK → ReferralCode.id
  /**
   * Event type: click | signup | lead | order
   */
  event          String // click | signup | lead | order
  /**
   * The landing page URL that was visited
   */
  landingUrl     String?  @map("landing_url")
  /**
   * Visitor UTM parameters (stored as JSON)
   */
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  utmTerm        String?  @map("utm_term")
  utmContent     String?  @map("utm_content")
  /**
   * Visitor IP (hashed for privacy)
   */
  ipHash         String?  @map("ip_hash")
  /**
   * Visitor user-agent
   */
  userAgent      String?  @map("user_agent")
  /**
   * Attributed SalesLead ID (if event = lead or order)
   */
  salesLeadId    String?  @map("sales_lead_id")
  /**
   * Attributed Order ID (if event = order)
   */
  orderId        String?  @map("order_id")
  /**
   * Revenue in VND for order events
   */
  revenue        Int      @default(0)
  /**
   * LP awarded to referrer for this conversion
   */
  lpAwarded      Int      @default(0) @map("lp_awarded")
  createdAt      DateTime @default(now()) @map("created_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id])

  @@index([referralCodeId, event])
  @@index([referralCodeId])
  @@index([createdAt])
  @@map("referral_tracking")
}

// ─── SALES CRM ─────────────────────────────────────────────────────

/// Customer leads tracked through the sales pipeline.
model SalesLead {
  id              String   @id @default(cuid())
  source          String   @default("website") // facebook | zalo | website | referral | cold_call
  customerName    String   @map("customer_name")
  customerEmail   String?  @map("customer_email")
  customerPhone   String?  @map("customer_phone")
  companyName     String?  @map("company_name")
  area            String   @default("can_tho") // can_tho | an_giang | kien_giang | dong_thap | long_an | tien_giang | vinh_long | ben_tre | tra_vinh
  tier            String   @default("sme") // key_account | sme | fb | retail
  status          String   @default("new") // new | contacted | qualified | proposal | won | lost
  note            String?  @db.Text
  estimatedBudget Int?     @map("estimated_budget") // VND
  assignedTo      String?  @map("assigned_to") // TeamMember.id
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  quotes Quote[]
  orders Order[]

  /**
   * Referral code used to create this lead
   */
  referralCodeId String?       @map("referral_code_id")
  referralCode   ReferralCode? @relation("ReferralCodeLeads", fields: [referralCodeId], references: [id])

  @@index([status, area])
  @@index([assignedTo])
  @@index([referralCodeId])
  @@map("sales_leads")
}

/// Internal sales quote with LP allocation per team role.
model Quote {
  id          String    @id @default(cuid())
  salesLeadId String    @map("sales_leads_id")
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id])
  orderId     String?   @map("order_id")
  order       Order?    @relation(fields: [orderId], references: [id])

  quoteNumber String @unique @map("quote_number")
  title       String
  totalAmount Int    @map("total_amount") // VND

  // LP allocation breakdown (sums to 100%)
  lpAllocation Json @default("{}") @map("lp_allocation") // {sales, design, pm, dev, qa, seo} → percentage

  /**
   * Selected advanced feature IDs for auto-pricing
   */
  selectedFeatureIds     Json?               @default("[]") @map("selected_feature_ids")
  /**
   * Infrastructure tier slug (e.g. "basic", "pro", "enterprise") for auto-pricing
   */
  infrastructureTierSlug String?             @map("infrastructure_tier_slug")
  /**
   * Infrastructure tier ID snapshot at time of quote
   */
  infrastructureTierId   String?             @map("infrastructure_tier_id")
  infrastructureTier     InfrastructureTier? @relation(fields: [infrastructureTierId], references: [id])

  status     String    @default("draft") // draft | sent | approved | rejected | expired
  validUntil DateTime? @map("valid_until")

  sentAt     DateTime? @map("sent_at")
  approvedAt DateTime? @map("approved_at")
  signedAt   DateTime? @map("signed_at")

  // Milestone-based payment schedule
  milestones Json? @map("milestones") // [{name, amount, dueDate}]

  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([salesLeadId])
  @@index([orderId])
  @@index([status])
  @@index([infrastructureTierId])
  @@map("quotes")
}

