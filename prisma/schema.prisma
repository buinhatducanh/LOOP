generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── RBAC ────────────────────────────────────────────────────────

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  displayName String       @map("display_name")
  description String?
  level       Int          @default(0)
  isSystem    Boolean      @default(false) @map("is_system")
  permissions Permission[]
  users       UserRole[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  resource String
  action   String
  scope    String @default("all")
  roleId   String @map("role_id")
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String    @map("role_id")
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy String?   @map("assigned_by")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ─── AUTH & SESSIONS ─────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String   @map("ip_address")
  userAgent String   @map("user_agent")
  location  String?
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("login_history")
}

// ─── AUDIT & NOTIFICATIONS ──────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  data      Json?
  link      String?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── USERS ──────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?  @map("password_hash")
  avatar       String?
  role         String   @default("user")
  googleId     String?  @unique @map("google_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles     UserRole[]
  sessions      Session[]
  loginHistory  LoginHistory[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("users")
}

// ─── CONTENT ────────────────────────────────────────────────────

model Service {
  id               String    @id @default(cuid())
  slug             String    @unique
  icon             String
  title            String
  shortDescription String    @map("short_description")
  longDescription  String    @map("long_description")
  features         String[]
  technologies     String[]
  startingPrice    Int       @map("starting_price")
  deliveryTime     String    @map("delivery_time")
  category         String
  isActive         Boolean   @default(true) @map("is_active")
  sortOrder        Int       @default(0) @map("sort_order")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  projects         Project[]

  @@map("services")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  client      String
  year        String
  image       String
  description String
  techStack   String[] @map("tech_stack")
  features    String[]
  results     String
  screenshots String[]
  isPublished Boolean  @default(true) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  serviceId   String?  @map("service_id")
  service     Service? @relation(fields: [serviceId], references: [id])

  @@map("projects")
}

model PricingPlan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  price       Int?
  period      String
  tagline     String
  features    String[]
  notIncluded String[] @map("not_included")
  highlighted Boolean  @default(false)
  cta         String   @default("Get Started")
  color       String   @default("#3B82F6")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("pricing_plans")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  avatar    String
  rating    Int      @default(5)
  text      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_messages")
}

model TeamMember {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  role         String
  bio          String   @db.Text
  shortBio     String   @map("short_bio")
  image        String
  expertise    String[]
  achievements String[]
  linkedin     String?
  twitter      String?
  github       String?
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // ── Role Hierarchy & Premium Fields ──
  roleLevel    Int      @default(4) @map("role_level")    // 0=CEO, 1=CTO/VP, 2=Lead, 3=Senior, 4=Member
  roleCategory String?  @map("role_category")             // "leadership", "management", "engineering", "design", "operations"
  coverImage   String?  @map("cover_image")               // Large cover image for detail page
  quote        String?                                     // Personal quote/slogan
  email        String?                                     // Public email
  phone        String?                                     // Phone number
  skills       String[]                                    // Professional skills
  experience   String?  @db.Text                           // Work experience description
  social       Json?                                       // Social links as JSON
  isWorking    Boolean  @default(true) @map("is_working")  // Currently working
  isFeatured   Boolean  @default(false) @map("is_featured") // Featured member (displayed larger)

  @@map("team_members")
}

model ServicePackage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  type           String
  price          Int?
  priceText      String?  @map("price_text")
  shortDesc      String   @map("short_desc")
  features       String[]
  isSubscription Boolean  @default(false) @map("is_subscription")
  billingPeriod  String?  @map("billing_period")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("service_packages")
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique @map("order_number")
  orderType       String         @default("package") @map("order_type") // "package" | "template" | "custom"
  packageId       String?        @map("package_id")
  package         ServicePackage? @relation(fields: [packageId], references: [id])
  templateId      String?        @map("template_id")
  template        WebTemplate?   @relation(fields: [templateId], references: [id])
  customerName    String         @map("customer_name")
  customerEmail   String         @map("customer_email")
  customerPhone   String?        @map("customer_phone")
  companyName     String?        @map("company_name")
  requirements    String?        @db.Text
  brandGuidelines String?        @map("brand_guidelines") @db.Text
  status          String         @default("pending")
  paymentStatus   String         @default("unpaid") @map("payment_status")
  totalAmount     Int?           @map("total_amount")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // ── Pricing (Platform Architecture) ──
  basePrice              Int?    @map("base_price")              // Giá base tại thời điểm đặt (snapshot)
  systemCalculatedPrice  Int?    @map("system_calculated_price") // = base + Σ(advanced features)
  adminOverridePrice     Int?    @map("admin_override_price")    // Giá Admin ghi đè
  adminPriceNote         String? @map("admin_price_note")        // Lý do điều chỉnh giá
  finalPrice             Int?    @map("final_price")             // = adminOverridePrice ?? systemCalculatedPrice

  // ── XP & Rewards ──
  totalXp                Int     @default(0) @map("total_xp")
  rewardLevel            Int     @default(1) @map("reward_level")

  // ── Payment details ──
  paymentMethod          String? @map("payment_method")          // "full" | "split_50_50"
  paidAmount             Int     @default(0) @map("paid_amount")

  // ── Domain ──
  domainName             String? @map("domain_name")

  // Relations
  selectedAttributes OrderAttribute[]
  orderRewards       OrderReward[]
  payments           Payment[]
  statusHistory      OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([orderType, status])
  @@index([customerEmail])
  @@map("orders")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  group String @default("general")

  @@map("site_settings")
}

// ─── DUAL SERVICE MODEL ─────────────────────────────────────────

// Kho tính năng mở rộng (Feature Catalog) — admin quản lý
// Dùng chung cho cả 2 luồng: Web Gói (gắn cứng) & Web Thiết Kế (khách chọn)
model ServiceAttribute {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  nameVi        String  @map("name_vi")
  description   String?
  descriptionVi String? @map("description_vi")
  category      String  // VD: "performance", "security", "ecommerce", "seo"
  categoryVi    String  @map("category_vi")
  icon          String?
  price         Int     @default(0) // Giá khi khách chọn riêng lẻ (Custom flow)
  isRequired    Boolean @default(false) @map("is_required") // Bắt buộc cho mọi dự án
  sortOrder     Int     @default(0) @map("sort_order")
  isActive      Boolean @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // ── Tier & XP (Platform Architecture) ──
  tier          String  @default("basic") // "basic" | "advanced"
  xpPoints      Int     @default(0) @map("xp_points") // Điểm XP (chỉ advanced > 0)
  parentId      String? @map("parent_id") // Quan hệ cha-con (mutual exclusion)
  parent        ServiceAttribute?  @relation("FeatureHierarchy", fields: [parentId], references: [id])
  children      ServiceAttribute[] @relation("FeatureHierarchy")

  // Relations
  templateAttributes WebTemplateAttribute[]
  orderAttributes    OrderAttribute[]

  @@index([tier, isActive])
  @@index([category, tier])
  @@index([parentId])
  @@map("service_attributes")
}

// Kho giao diện (Template Gallery) — Luồng "Web Gói"
model WebTemplate {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  nameVi          String  @map("name_vi")
  description     String?
  descriptionVi   String? @map("description_vi")
  category        String  // VD: "landing-page", "ecommerce", "portfolio", "corporate"
  categoryVi      String  @map("category_vi")
  thumbnail       String  // URL ảnh thumbnail
  screenshots     String[] // Ảnh chụp màn hình chi tiết
  demoUrl         String  @map("demo_url") // Link demo thực tế (Vercel, etc.)
  price           Int     // Giá trọn gói
  originalPrice   Int?    @map("original_price") // Giá gốc (nếu muốn hiển thị giảm giá)
  currency        String  @default("VND")
  technologies    String[] // VD: ["Next.js", "TailwindCSS", "PostgreSQL"]
  deliveryTime    String  @map("delivery_time") // VD: "3-5 ngày"
  highlighted     Boolean @default(false) // Nổi bật
  sortOrder       Int     @default(0) @map("sort_order")
  isActive        Boolean @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // ── Level system (Platform Architecture) ──
  level           Int     @default(1) // Cấp độ gói: 1=Cơ bản, 2=Trung cấp, 3=Nâng cao, 4=Premium
  levelLabel      String? @map("level_label") // "Basic", "Pro", "Enterprise"
  levelLabelVi    String? @map("level_label_vi") // "Cơ bản", "Chuyên nghiệp", "Doanh nghiệp"

  // Relations — Các tính năng đi kèm (gắn cứng)
  bundledAttributes WebTemplateAttribute[]
  orders            Order[]

  @@index([level, isActive])
  @@index([category, isActive])
  @@map("web_templates")
}

// Bảng nối: Template <-> Attribute (tính năng gắn cứng vào gói)
model WebTemplateAttribute {
  id          String @id @default(cuid())
  templateId  String @map("template_id")
  template    WebTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attributeId String @map("attribute_id")
  attribute   ServiceAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([templateId, attributeId])
  @@map("web_template_attributes")
}

// Bảng nối: Order <-> Attribute (tính năng khách chọn riêng - Custom flow)
model OrderAttribute {
  id          String @id @default(cuid())
  orderId     String @map("order_id")
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attributeId String @map("attribute_id")
  attribute   ServiceAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  priceAtOrder Int   @map("price_at_order") // Snapshot giá tại thời điểm đặt hàng

  @@unique([orderId, attributeId])
  @@map("order_attributes")
}

// ─── PRICING CALCULATOR (BÁO GIÁ ĐỘNG) ─────────────────────────

model FeatureGroup {
  id        String    @id @default(cuid())
  groupName String    @map("group_name")
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  features  Feature[]

  @@map("feature_groups")
}

model Feature {
  id          String           @id @default(cuid())
  groupId     String           @map("group_id")
  group       FeatureGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  featureName String           @map("feature_name")
  description String?
  logicLevel  String           @default("Medium") @map("logic_level")
  isRequired  Boolean          @default(false) @map("is_required")
  sortOrder   Int              @default(0) @map("sort_order")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  variants    FeatureVariant[]

  @@map("features")
}

model FeatureVariant {
  id            String   @id @default(cuid())
  featureId     String   @map("feature_id")
  feature       Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  variantName   String   @map("variant_name")
  description   String?
  price         Int      @default(0)
  resourceUsage Json?    @map("resource_usage")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("feature_variants")
}

model QuoteRequest {
  id             String   @id @default(cuid())
  customerName   String   @map("customer_name")
  customerEmail  String   @map("customer_email")
  customerPhone  String?  @map("customer_phone")
  companyName    String?  @map("company_name")
  selectedItems  Json     @map("selected_items")
  totalAmount    Int      @map("total_amount")
  notes          String?
  status         String   @default("new")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("quote_requests")
}

// ─── PRICING PACKAGES (ADMIN-MANAGED) ─────────────────────────

model PricingWebPackage {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameVi      String   @map("name_vi")
  tagline     String
  taglineVi   String   @map("tagline_vi")
  price       Int
  currency    String   @default("VND")
  period      String
  periodVi    String   @map("period_vi")
  highlighted Boolean  @default(false)
  cta         String
  ctaVi       String   @map("cta_vi")
  color       String   @default("#3B82F6")
  pages       String
  pagesVi     String   @map("pages_vi")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("pricing_web_packages")
}

model PricingFeatureCategory {
  id        String                     @id @default(cuid())
  slug      String                     @unique
  name      String
  nameVi    String                     @map("name_vi")
  sortOrder Int                        @default(0) @map("sort_order")
  isActive  Boolean                    @default(true) @map("is_active")
  features  PricingComparisonFeature[]

  @@map("pricing_feature_categories")
}

model PricingComparisonFeature {
  id         String                 @id @default(cuid())
  categoryId String                 @map("category_id")
  category   PricingFeatureCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  nameVi     String                 @map("name_vi")
  tooltip    String?
  tooltipVi  String?                @map("tooltip_vi")
  values     Json
  sortOrder  Int                    @default(0) @map("sort_order")
  isActive   Boolean                @default(true) @map("is_active")

  @@map("pricing_comparison_features")
}

model PricingHostingPlan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameVi      String   @map("name_vi")
  price       Int
  period      String
  periodVi    String   @map("period_vi")
  features    String[]
  featuresVi  String[] @map("features_vi")
  highlighted Boolean  @default(false)
  color       String   @default("#3B82F6")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("pricing_hosting_plans")
}

model PricingDomainPrice {
  id                String  @id @default(cuid())
  extension         String  @unique
  registrationPrice Int     @map("registration_price")
  renewalPrice      Int     @map("renewal_price")
  period            String
  periodVi          String  @map("period_vi")
  note              String?
  noteVi            String? @map("note_vi")
  sortOrder         Int     @default(0) @map("sort_order")
  isActive          Boolean @default(true) @map("is_active")

  @@map("pricing_domain_prices")
}

model PricingDeploymentItem {
  id             String  @id @default(cuid())
  slug           String  @unique
  title          String
  titleVi        String  @map("title_vi")
  description    String
  descriptionVi  String  @map("description_vi")
  handedToClient Boolean @default(true) @map("handed_to_client")
  icon           String
  note           String?
  noteVi         String? @map("note_vi")
  sortOrder      Int     @default(0) @map("sort_order")
  isActive       Boolean @default(true) @map("is_active")

  @@map("pricing_deployment_items")
}

// ─── PLATFORM ARCHITECTURE: NEW ENTITIES ─────────────────────────

// Dịch vụ rời (Add-on Services) — mua độc lập hoặc dùng làm reward
model AddonService {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameVi        String   @map("name_vi")
  description   String?
  descriptionVi String?  @map("description_vi")
  icon          String?
  type          String   @default("one_time") // "one_time" | "recurring"
  price         Int                            // Giá (VND)
  billingPeriod String?  @map("billing_period") // "monthly" | "quarterly" | "yearly"
  metadata      Json?                           // Chi tiết bổ sung
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  rewardTierItems RewardTierItem[]
  orderRewards    OrderReward[]

  @@map("addon_services")
}

// Cấu hình reward theo level XP
model RewardTier {
  id          String   @id @default(cuid())
  level       Int      @unique             // Level: 2, 3, 4, ...
  name        String                       // "Advanced Project"
  nameVi      String   @map("name_vi")     // "Dự án Nâng cao"
  description String?
  minXp       Int      @map("min_xp")      // XP tối thiểu
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items RewardTierItem[]

  @@map("reward_tiers")
}

// Chi tiết reward trong mỗi level
model RewardTierItem {
  id              String       @id @default(cuid())
  rewardTierId    String       @map("reward_tier_id")
  rewardTier      RewardTier   @relation(fields: [rewardTierId], references: [id], onDelete: Cascade)
  addonServiceId  String       @map("addon_service_id")
  addonService    AddonService @relation(fields: [addonServiceId], references: [id])
  quantity        Int          @default(1)
  durationMonths  Int?         @map("duration_months") // Thời hạn (tháng) cho recurring
  description     String?
  sortOrder       Int          @default(0) @map("sort_order")

  @@unique([rewardTierId, addonServiceId])
  @@map("reward_tier_items")
}

// Reward đã áp dụng cho đơn hàng cụ thể
model OrderReward {
  id              String       @id @default(cuid())
  orderId         String       @map("order_id")
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addonServiceId  String       @map("addon_service_id")
  addonService    AddonService @relation(fields: [addonServiceId], references: [id])
  rewardLevel     Int          @map("reward_level")
  quantity        Int          @default(1)
  durationMonths  Int?         @map("duration_months")
  startDate       DateTime?    @map("start_date")
  endDate         DateTime?    @map("end_date")
  status          String       @default("pending") // "pending" | "active" | "expired" | "revoked"
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([orderId, status])
  @@index([status, endDate])
  @@map("order_rewards")
}

// Lịch sử thanh toán
model Payment {
  id          String    @id @default(cuid())
  orderId     String    @map("order_id")
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int                              // Số tiền thanh toán
  method      String?                          // "bank_transfer" | "cash" | "stripe" | "paypal"
  note        String?
  confirmedBy String?   @map("confirmed_by")   // Admin ID xác nhận
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("payments")
}

// Audit trail trạng thái đơn hàng
model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String   @map("from_status")
  toStatus   String   @map("to_status")
  changedBy  String?  @map("changed_by")  // Admin ID
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}
