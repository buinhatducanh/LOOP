model MemberEffectOverride {
  id               String   @id @default(cuid())
  memberId         String   @map("member_id")
  effectId         String   @map("effect_id")
  visible          Boolean  @default(true)
  selectedByMember Boolean  @default(true) @map("selected_by_member")
