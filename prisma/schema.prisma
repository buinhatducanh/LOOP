  @@unique([projectId, memberId, date])
  @@index([projectId])
  @@index([memberId])
  @@map("daily_standups")
}

/// Maintenance contract per project — renewal tracking + auto-renewal reminders.
model MaintenanceContract {
  id                  String   @id @default(cuid())
  projectId           String   @map("project_id") // FK → Order.id
  title               String // e.g. "Bảo trì Website CoffeeShop 2026"
  price               Int      @map("price") // VND per billing period
  billingCycle        String   @default("monthly") // monthly | quarterly | yearly
  startDate           DateTime @map("start_date")
  endDate             DateTime @map("end_date")
  autoRenew           Boolean  @default(false) @map("auto_renew")
  status              String   @default("active") // active | expiring_soon | expired | cancelled
  renewalReminderSent Boolean  @default(false) @map("renewal_reminder_sent")
  note                String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  project Order @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([endDate])
