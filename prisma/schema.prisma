// ─── CUSTOMER WEBSITE MANAGEMENT ──────────────────────────────────

// Website đã bán cho khách hàng
model CustomerWebsite {
  id      String  @id @default(cuid())
  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id])

  // Thông tin website
  domain      String // Domain của website (VD: example.com)
  subdomain   String? @map("subdomain") // Subdomain nếu có
  name        String // Tên website
  description String? @db.Text

  // Hosting info
  hostingProvider String? @map("hosting_provider") // "vercel", "neon", "custom"
  hostingUrl      String? @map("hosting_url")

  // Thông tin khách hàng
  customerId    String? @map("customer_id")
  customerName  String? @map("customer_name")
  customerEmail String? @map("customer_email")
  customerPhone String? @map("customer_phone")

  // Trạng thái
  status      String  @default("active") // "active", "inactive", "suspended", "expired"
  isMonitored Boolean @default(true) @map("is_monitored")

  // Timestamps
  deployedAt DateTime? @map("deployed_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  websiteStats WebsiteStats[]
  pageViews    WebsitePageView[]

  @@unique([domain])
  @@index([status])
  @@index([customerEmail])
  @@map("customer_websites")
}

// Thống kê website hàng ngày
model WebsiteStats {
  id        String          @id @default(cuid())
  websiteId String          @map("website_id")
  website   CustomerWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  date               DateTime @db.Date // Ngày thống kê
  visitors           Int      @default(0) // Số visitors
  pageViews          Int      @default(0) // Số page views
  uniqueVisitors     Int      @default(0) // Số visitors unique
  bounceRate         Float?   @map("bounce_rate") // Tỷ lệ bounce
  avgSessionDuration Int?     @map("avg_session_duration") // Thời gian session TB (giây)

  // Performance
  uptime       Float @default(100) // % uptime trong ngày
  responseTime Int?  @map("response_time") // Response time TB (ms)
  errorRate    Float @default(0) @map("error_rate") // % lỗi

  // Traffic sources
  organicSearch   Int @default(0) @map("organic_search")
  directTraffic   Int @default(0) @map("direct_traffic")
  socialTraffic   Int @default(0) @map("social_traffic")
  referralTraffic Int @default(0) @map("referral_traffic")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([websiteId, date])
  @@index([websiteId, date])
  @@map("website_stats")
}

// Chi tiết page views theo trang
model WebsitePageView {
  id        String          @id @default(cuid())
  websiteId String          @map("website_id")
  website   CustomerWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  pageUrl       String  @map("page_url")
  pageTitle     String? @map("page_title")
  views         Int     @default(1)
  uniqueViews   Int     @default(1)
  avgTimeOnPage Float?  @map("avg_time_on_page")
  exitRate      Float?  @map("exit_rate")

  date DateTime @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@index([websiteId, date])
  @@map("website_page_views")
}

// ─── POINTS & REWARDS SYSTEM ─────────────────────────────────────

// Tài khoản điểm của khách hàng
model CustomerPoint {
  id        String  @id @default(cuid())
  userId    String? @map("user_id")
  userEmail String  @map("user_email")
  userName  String? @map("user_name")

  // Points balance
  balance     Int @default(0) // Số dư điểm hiện tại
  totalEarned Int @default(0) @map("total_earned") // Tổng điểm đã kiếm được
  totalSpent  Int @default(0) @map("total_spent") // Tổng điểm đã tiêu

  // Level system
  level     Int @default(1)
  currentXp Int @default(0) @map("current_xp")

  // Streak (chuỗi ngày liên tiếp)
  loginStreak   Int       @default(0) @map("login_streak")
  lastLoginDate DateTime? @map("last_login_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  transactions   PointTransaction[]
  adWatchHistory AdWatchHistory[]

  @@unique([userEmail])
  @@index([balance])
  @@map("customer_points")
}

// Lịch sử giao dịch điểm
model PointTransaction {
  id              String        @id @default(cuid())
  customerPointId String        @map("customer_point_id")
  customerPoint   CustomerPoint @relation(fields: [customerPointId], references: [id], onDelete: Cascade)

  type   String // "earn" | "spend" | "expire" | "refund"
  amount Int // Số điểm (+/-)

  // Nguồn điểm
  source      String // "daily_login", "watch_ad", "purchase", "upgrade", "referral", "review"
  description String // Mô tả

  // Liên kết
  referenceId   String? @map("reference_id") // Order ID, ad ID, etc.
  referenceType String? @map("reference_type") // "order", "advertisement", etc.

  // Trạng thái
  status String @default("completed") // "pending", "completed", "cancelled"

  expiresAt DateTime? @map("expires_at") // Điểm có thể hết hạn
  expiredAt DateTime? @map("expired_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([customerPointId, createdAt])
  @@index([type, createdAt])
  @@map("point_transactions")
}

// Cấu hình điểm thưởng cho các hoạt động
model PointActivity {
  id   String @id @default(cuid())
  slug String @unique

  name          String
  nameVi        String  @map("name_vi")
  description   String?
  descriptionVi String? @map("description_vi")

  // Rewards
  points  Int // Số điểm nhận được
  xpBonus Int @default(0) @map("xp_bonus") // Bonus XP

  // Limits
  dailyLimit Int? @map("daily_limit") // Giới hạn/ngày
  totalLimit Int? @map("total_limit") // Tổng giới hạn

  // Conditions
  minLevel         Int     @default(1) @map("min_level") // Cấp độ tối thiểu
  requiresPurchase Boolean @default(false) @map("requires_purchase") // Cần mua hàng

  // Status
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  // For ads
  adVideoUrl String? @map("ad_video_url")
  adDuration Int?    @map("ad_duration") // Thời lượng video (giây)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("point_activities")
}

// Video quảng cáo để xem kiếm điểm
model Advertisement {
  id   String @id @default(cuid())
  slug String @unique

  title         String
  titleVi       String  @map("title_vi")
  description   String?
  descriptionVi String? @map("description_vi")

  // Video
  videoUrl     String  @map("video_url")
  thumbnailUrl String? @map("thumbnail_url")
  duration     Int // Thời lượng (giây)

  // Rewards
  points  Int @default(10)
  xpBonus Int @default(0) @map("xp_bonus")

  // Limits
  dailyLimit    Int @default(5) @map("daily_limit")
  watchCooldown Int @default(3600) @map("watch_cooldown") // Cooldown giữa 2 lần xem (giây)

  // Status
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  // Target audience
  minLevel         Int     @default(1) @map("min_level")
  requiresPurchase Boolean @default(false) @map("requires_purchase")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("advertisements")
}

// Lịch sử xem quảng cáo
model AdWatchHistory {
  id              String        @id @default(cuid())
  customerPointId String        @map("customer_point_id")
  customerPoint   CustomerPoint @relation(fields: [customerPointId], references: [id], onDelete: Cascade)

  advertisementId String @map("advertisement_id")
  adSlug          String @map("ad_slug")

  watchedAt    DateTime @default(now()) @map("watched_at")
  pointsEarned Int      @map("points_earned")
  xpEarned     Int      @default(0) @map("xp_earned")

  // Completion status
  completed     Boolean @default(false) // Đã xem đủ thời lượng chưa
  watchDuration Int     @default(0) @map("watch_duration") // Thời gian thực tế đã xem

  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([customerPointId, watchedAt])
  @@index([advertisementId])
  @@map("ad_watch_history")
}

// Login streak rewards configuration
model DailyReward {
  id      String @id @default(cuid())
  day     Int // Ngày trong chuỗi (1, 2, 3, ...)
  points  Int
  xpBonus Int    @default(0) @map("xp_bonus")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([day])
  @@map("daily_rewards")
}

// ─── Server Analytics Events ──────────────────────────────────────────────
// Stores raw analytics events for business intelligence dashboards.
// Created by: src/lib/analytics/server.ts
// NOTE: This table is optional — analytics still work via AuditLog if this model is not migrated.
model ServerAnalyticsEvent {
  id         String   @id @default(cuid())
  event      String
  properties Json     @default("{}")
  sessionId  String?  @map("session_id")
  visitorId  String?  @map("visitor_id")
  userId     String?  @map("user_id")
  locale     String?
  page       String?
  referrer   String?
  userAgent  String?  @map("user_agent")
  ip         String?
  country    String?
  city       String?
  device     String? // desktop, mobile, tablet
  browser    String?
  os         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([createdAt])
  @@index([sessionId])
  @@map("server_analytics_events")
}

// ─── PROJECT MANAGEMENT (JIRA-like) ─────────────────────────────────────

/// Links a TeamMember to an Order (project) with a project-specific role and LP tracking.
model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id") // FK → Order.id
  memberId    String   @map("member_id") // FK → TeamMember.id
  projectRole String   @default("MEMBER") @map("project_role") // PM | DEV | QA | SEO | DESIGN | MEMBER
  assignedLp  Int      @default(0) @map("assigned_lp")
  earnedLp    Int      @default(0) @map("earned_lp")
  exp         Int      @default(0)
  joinedAt    DateTime @default(now()) @map("joined_at")

  project Order      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([projectId])
  @@map("project_members")
}

/// Groups backlogs within a project. Coloured by PM for visual grouping.
model Epic {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  title     String
  color     String   @default("#6366F1") // hex colour for sidebar badges
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  project  Order     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  backlogs Backlog[]

  @@index([projectId])
  @@map("epics")
}

/// A container of tasks within a project. PM allocates LP budget (totalLp) to it.
model Backlog {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id") // FK → Order.id
  epicId      String?  @map("epic_id") // FK → Epic.id (optional grouping)
  name        String // Primary name (used by existing API)
  title       String   @default("") // Mirrors name for display flexibility
  description String?  @db.Text
  totalLp     Int      @default(0) @map("total_lp") // LP budget allocated by PM
  usedLp      Int      @default(0) @map("used_lp") // LP already assigned to tasks
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Order  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epic    Epic?  @relation(fields: [epicId], references: [id])
  tasks   Task[]

  @@index([projectId])
  @@index([epicId])
  @@map("backlogs")
}

/// SLA rules per project — define max hours per priority level.
model SlaRule {
  id        String   @id @default(cuid())
  projectId String   @map("project_id") // FK → Order.id
  priority  String // low | medium | high | critical
  maxHours  Int      @map("max_hours")
  createdAt DateTime @default(now()) @map("created_at")

  project Order @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, priority])
  @@map("sla_rules")
}

/// A single work item. Core of the JIRA-like board.
model Task {
  id             String    @id @default(cuid())
  backlogId      String    @map("backlog_id") // FK → Backlog.id
  title          String
  description    String?   @db.Text
  lp             Int       @default(0) // LP value of the task
  status         String    @default("backlog") @map("status") // backlog | in_progress | in_review | done
  priority       String    @default("medium") @map("priority") // low | medium | high | critical
  assigneeId     String?   @map("assignee_id") // FK → TeamMember.id
  branchName     String?   @map("branch_name") // e.g. task-abc123-fix-login
  mergeCommit    String?   @map("merge_commit") // commit SHA if merged to main
  mergedAt       DateTime? @map("merged_at")
  completedAt    DateTime? @map("completed_at")
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  violated       Boolean   @default(false) @map("violated") // SLA breach flag
  slaDeadline    DateTime? @map("sla_deadline")
  externalId     String?   @map("external_id")
  estimatedHours Int?      @map("estimated_hours")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  backlog    Backlog         @relation(fields: [backlogId], references: [id], onDelete: Cascade)
  assignee   TeamMember?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  tags       TaskTag[]
  bugNotes   BugNote[]
  commits    GitCommit[]
  lpAwards   LpAward[]
  violations TaskViolation[]

  @@index([backlogId])
  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

/// SLA violation record for a task.
model TaskViolation {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  type      String   @default("sla_breach") @map("type") // sla_breach | deadline_missed
  revokedLp Int      @default(0) @map("revoked_lp")
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_violations")
}

/// Labels/tags for filtering tasks.
model TaskTag {
  id     String @id @default(cuid())
  taskId String @map("task_id") // FK → Task.id
  name   String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, name])
  @@map("task_tags")
}

/// QA bug reports attached to a task.
model BugNote {
  id         String    @id @default(cuid())
  taskId     String    @map("task_id") // FK → Task.id
  authorId   String    @map("author_id") // FK → TeamMember.id
  content    String    @db.Text
  severity   String    @default("medium") @map("severity") // low | medium | high | critical
  status     String    @default("open") @map("status") // open | acknowledged | resolved
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author TeamMember @relation("BugNoteAuthor", fields: [authorId], references: [id])

  @@index([taskId])
  @@map("bug_notes")
}

/// Received from GitHub/GitLab webhooks. Auto-linked to task via branch naming convention.
model GitCommit {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id") // FK → Order.id
  taskId       String?  @map("task_id") // FK → Task.id (nullable, auto-linked via branch)
  sha          String   @unique
  message      String   @db.Text
  authorName   String   @map("author_name")
  authorEmail  String   @map("author_email")
  branch       String
  eventType    String   @default("push") @map("event_type") // push | merge | pull_request
  mergedToMain Boolean  @default(false) @map("merged_to_main")
  lpAwarded    Boolean  @default(false) @map("lp_awarded")
  expAwarded   Boolean  @default(false) @map("exp_awarded")
  committedAt  DateTime @map("committed_at")
  receivedAt   DateTime @default(now()) @map("received_at")

  project Order @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task? @relation(fields: [taskId], references: [id])

  @@index([projectId])
  @@index([taskId])
  @@map("git_commits")
}

/// LP/EXP awards earned by members. Pending → approved by PM/CEO.
model LpAward {
  id             String    @id @default(cuid())
  taskId         String?   @map("task_id") // FK → Task.id
  projectId      String    @map("project_id") // FK → Order.id
  memberId       String    @map("member_id") // FK → TeamMember.id
  lpAmount       Int       @default(0) @map("lp_amount")
  expAmount      Int       @default(0) @map("exp_amount")
  source         String    @default("manual") @map("source") // manual | task_done | commit_merge | seo_published
  status         String    @default("pending") @map("status") // pending | approved | rejected
  approvedBy     String?   @map("approved_by") // FK → TeamMember.id
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")

  task     Task?       @relation(fields: [taskId], references: [id])
  project  Order       @relation(fields: [projectId], references: [id])
  member   TeamMember  @relation("LpAwardMember", fields: [memberId], references: [id])
  approver TeamMember? @relation("LpAwardApprover", fields: [approvedBy], references: [id])

  @@index([projectId, memberId])
  @@index([taskId])
  @@map("lp_awards")
}

/// Figma demo review workflow per project.
model FigmaDemo {
  id            String    @id @default(cuid())
  projectId     String    @map("project_id") // FK → Order.id
  title         String
  figmaUrl      String    @map("figma_url")
  versionHash   String?   @map("version_hash")
  status        String    @default("pending") @map("status") // pending | approved_by_client | rejected | approved
  clientEmail   String?   @map("client_email")
  clientToken   String?   @unique @map("client_token") // unique token for public review link
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  rejectionNote String?   @map("rejection_note") @db.Text
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project Order @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("figma_demos")
}

/// Environment variable files per project/environment.
model EnvFile {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id") // FK → Order.id
  environment String   @map("environment") // dev | staging | prod
  fileKey     String   @map("file_key") // e.g. ".env.local"
  content     String   @db.Text // current file content
  version     Int      @default(1)
  editedBy    String?  @map("edited_by") // FK → TeamMember.id
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Order            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  editor  TeamMember?      @relation("EnvFileEditor", fields: [editedBy], references: [id])
  history EnvFileHistory[]

  @@unique([projectId, environment, fileKey])
  @@index([projectId])
  @@map("env_files")
}

/// Version history for EnvFile — created on every edit.
model EnvFileHistory {
  id           String   @id @default(cuid())
  envFileId    String   @map("env_file_id") // FK → EnvFile.id
  version      Int
  content      String   @db.Text
  diffFromPrev Json?    @map("diff_from_prev") // JSON patch from previous version
  editedBy     String?  @map("edited_by") // FK → TeamMember.id
  createdAt    DateTime @default(now()) @map("created_at")

  envFile EnvFile @relation(fields: [envFileId], references: [id], onDelete: Cascade)

  @@index([envFileId])
  @@map("env_file_histories")
}

/// SEO blog posts per project.
model BlogPost {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id") // FK → Order.id
  title       String
  slug        String

  // ── Primary content (Vietnamese) ───────────────────────────────────────────────
  content     String?   @db.Text
  excerpt     String?   @db.Text

  // ── Translations ───────────────────────────────────────────────────────────
  titleEn     String?   @map("title_en")
  titleJa     String?   @map("title_ja")
  titleKo     String?   @map("title_ko")
  titleZh     String?   @map("title_zh")

  contentEn   String?   @map("content_en") @db.Text
  contentJa   String?   @map("content_ja") @db.Text
  contentKo   String?   @map("content_ko") @db.Text
  contentZh   String?   @map("content_zh") @db.Text

  excerptEn   String?   @map("excerpt_en") @db.Text
  excerptJa   String?   @map("excerpt_ja") @db.Text
  excerptKo   String?   @map("excerpt_ko") @db.Text
  excerptZh   String?   @map("excerpt_zh") @db.Text

  // SEO translations
  seoTitleEn  String?   @map("seo_title_en")
  seoTitleJa  String?   @map("seo_title_ja")
  seoTitleKo  String?   @map("seo_title_ko")
  seoTitleZh  String?   @map("seo_title_zh")

  seoDescEn   String?   @map("seo_desc_en")
  seoDescJa   String?   @map("seo_desc_ja")
  seoDescKo   String?   @map("seo_desc_ko")
  seoDescZh   String?   @map("seo_desc_zh")

  // ── Non-translatable fields ───────────────────────────────────────────────
  coverImage  String?   @map("cover_image")
  seoTitle    String?   @map("seo_title") // VI fallback
  seoDesc     String?   @map("seo_desc")  // VI fallback
  authorId    String    @map("author_id") // FK → TeamMember.id
  status      String    @default("draft") @map("status") // draft | published
  publishedAt DateTime? @map("published_at")
  lpEarned    Boolean   @default(false) @map("lp_earned")
  lpAwardedAt DateTime? @map("lp_awarded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Order      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  TeamMember @relation(fields: [authorId], references: [id])

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([authorId])
  @@map("blog_posts")
}

/// Client-facing project portal access token.
model ProjectPortalToken {
  id        String    @id @default(cuid())
  projectId String    @map("project_id") // FK → Order.id
  token     String    @unique @map("access_token") // UUID token for portal URL
  label     String    @default("Client Portal") // e.g. "Client Portal" or "Internal Review"
  expiresAt DateTime? @map("expires_at") // null = never expires
  isActive  Boolean   @default(true) @map("is_active")
  createdBy String    @map("created_by") // TeamMember.id
  createdAt DateTime  @default(now()) @map("created_at")

  project Order @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([token])
  @@map("project_portal_tokens")
}

/// Social media post linked to an order/project.
