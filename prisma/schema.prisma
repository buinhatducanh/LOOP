  publishedBy String?   @map("published_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  project Order @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("social_posts")
}

/// Tracks deployment history per project environment.
model Deployment {
  id            String    @id @default(cuid())
  projectId     String    @map("project_id") // FK → Order.id (kept as project_id for backward compat)
  environment   String    @map("environment") // dev | staging | production
  platform      String    @default("manual") @map("platform") // vercel | aws | gcp | manual
