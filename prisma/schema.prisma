  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  member TeamMember @relation("MemberEffectOverrides", fields: [memberId], references: [id], onDelete: Cascade)
  effect RankEffect @relation("RankEffectOverrides", fields: [effectId], references: [id], onDelete: Cascade)

  @@unique([memberId, effectId])
  @@index([memberId])
  @@index([effectId])
  @@index([visible])
  @@map("member_effect_overrides")
}

// ── Quests ─────────────────────────────────────────────────────────────────────
model Quest {
  id           String      @id @default(cuid())
  title        String
  description  String
  lpReward     Int         @map("lp_reward")
  xpReward     Int         @default(0) @map("xp_reward")
  /// * Frequency: daily | weekly | monthly | one_time | event | seasonal
  frequency    String
  /// * Category: engagement | project | social | learning | achievement
  category     String
  /// * Scope: company (all staff) | department (same dept) | personal (per member)
  scope        String      @default("company")
  departmentId String?     @map("department_id") // null = company-wide or personal
  department   Department? @relation(fields: [departmentId], references: [id])
  icon         String
  color        String
  target       Int         @default(1)
  forRoles     String[]    @map("for_roles")
  isActive     Boolean     @default(true) @map("is_active")
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  participants QuestParticipant[]

  @@map("quests")
}

// ── Company Events ─────────────────────────────────────────────────────────────
model CompanyEvent {
  id          String   @id @default(cuid())
  title       String
  description String
  /// * Event type: seasonal | competition | celebration | promotional
  type        String
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  lpBonus     Int      @map("lp_bonus")
  color       String
  icon        String
  bannerUrl   String?  @map("banner_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  participants QuestParticipant[]

  @@index([isActive, startDate])
  @@map("company_events")
}

// ── Inngest Job Run (DLQ observability) ──────────────────────────────────────
// Tracks every Inngest job execution for ops visibility and dead-letter monitoring.
// Mirrors Inngest run lifecycle: pending → running → succeeded │ failed │ dead
model InngestJob {
  id           String    @id @default(cuid())
  runId        String    @unique @map("run_id") // Inngest run ID (e.g. "01J9X…")
  functionId   String    @map("function_id") // Inngest function ID (e.g. "contact-confirmation-job")
  functionName String    @map("function_name") // Human-readable name (e.g. "Contact Confirmation")
  eventName    String    @map("event_name") // Triggering event or cron expression
  /// Status: pending | running | succeeded | failed | dead
  status       String    @default("pending")
  attemptCount Int       @default(0) @map("attempt_count")
  maxAttempts  Int       @default(3) @map("max_attempts")
  /// Raw error from last attempt
  errorMessage String?   @map("error_message")
  errorStack   String?   @map("error_stack")
  /// JSON: the original event/schedule payload
  payload      Json?     @map("payload")
  /// JSON: the function return value (on success)
  result       Json?     @map("result")
  /// Timestamps
  queuedAt     DateTime  @default(now()) @map("queued_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([functionId, status])
  @@index([runId])
  @@map("inngest_jobs")
}

// ── Idempotency Keys (BE deduplication) ─────────────────────────────────────
// Stores idempotency keys sent by FE client.ts to prevent duplicate mutations.
// Each endpoint that performs a non-idempotent write must support Idempotency-Key.
//
// Usage: Extract key from `Idempotency-Key` header → check existence → execute or return cached.
// TTL: 24 hours (auto-expire via DB-side cleanup job).
//
// Endpoints wired:
//   POST /api/services/order          → operation: "create_order"
//   POST /api/admin/orders           → operation: "create_order_admin"
//   POST /api/academy/enroll         → operation: "create_enrollment"
//   POST /api/admin/lp-awards        → operation: "create_lp_award"
//   POST /api/admin/lp-redemptions   → operation: "create_lp_redemption"
//
// @see src/lib/idempotency.ts for deduplication logic
model IdempotencyKey {
  id           String   @id @default(cuid())
  /// The raw Idempotency-Key header value (UUID)
  key          String   @unique @map("key")
  /// Logical operation type — e.g. "create_order", "create_enrollment"
  operation    String   @map("operation")
  /// User/member who initiated this request
  userId       String?  @map("user_id")
  memberId     String?  @map("member_id")
  /// HTTP status code of the cached response
  statusCode   Int      @map("status_code")
  /// Serialized response body to replay on duplicate
  responseBody Json     @map("response_body")
  /// When this key becomes stale and can be purged
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@index([expiresAt]) // For TTL cleanup queries
  @@index([operation, userId])
  @@index([operation, memberId])
  @@map("idempotency_keys")
}

// ── Quest Participants (join table) ───────────────────────────────────────────
model QuestParticipant {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  questId   String?   @map("quest_id")
  eventId   String?   @map("event_id")
  progress  Int       @default(0)
  completed Boolean   @default(false) @map("completed")
  lpEarned  Int       @default(0) @map("lp_earned")
  xpEarned  Int       @default(0) @map("xp_earned")
  claimedAt DateTime? @map("claimed_at")
  joinedAt  DateTime  @default(now()) @map("joined_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest?        @relation(fields: [questId], references: [id], onDelete: Cascade)
  event CompanyEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@unique([userId, eventId])
  @@index([userId])
  @@index([questId])
  @@index([eventId])
  @@map("quest_participants")
}

// ── Supported Locales (admin-configurable locale allowlist) ────────────────
// Controls which locales are available to clients on public pages.
// Admin can enable/disable locales from Settings tab without code changes.
model SupportedLocale {
  id         String  @id @default(cuid())
  code       String  @unique @map("code") // e.g. "vi", "en", "ja", "ko", "zh"
  name       String  @map("name") // e.g. "Tiếng Việt", "English"
  nativeName String  @map("native_name") // e.g. "Tiếng Việt", "English", "日本語"
  isEnabled  Boolean @default(true) @map("is_enabled")
  isDefault  Boolean @default(false) @map("is_default") // exactly one locale should be true
  order      Int     @default(0) @map("order") // display order in locale switcher

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("supported_locales")
}

/// Access Tag — arbitrary permission tag assigned by CEO during member onboarding.
/// Example: "blog-post", "seo-content", "kanban", "salary"
model AccessTag {
  id          String   @id @default(cuid())
  /// Slug identifier, e.g. "blog-post", "kanban", "salary"
  slug        String   @unique @map("slug")
  /// Display label, e.g. "Quản trị bài viết"
  label       String   @map("label")
  /// Description of what this tag grants access to
  description String?  @map("description")
  /// CSS hex color for UI badges, e.g. "#3B82F6"
  color       String   @default("#3B82F6") @map("color")
  /// Whether this tag is a default for all members (e.g. kanban, order-basic)
  isDefault   Boolean  @default(false) @map("is_default")
  /// Tags with isDefault=true cannot be revoked from members
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("access_tags")
}

/// Member onboarding request — created by HR, approved by CEO.
/// Workflow: HR creates → Member registers → CEO approves → Role + Tags assigned.
model MemberRequest {
  id              String    @id @default(cuid())
  /// Member's email — unique per pending request
  email           String    @unique @map("email")
  name            String    @map("name")
  /// Target department: engineering/design/media/marketing/sales/finance/hr/management
  department      String    @map("department")
  /// Proposed system role: member/media/qa/project_manager
  proposedRole    String    @map("proposed_role")
  /// Proposed access tags (CEO may change these)
  proposedTags    String[]  @default([]) @map("proposed_tags")
  /// Status: pending = waiting CEO, approved = role assigned, rejected = declined
  status          String    @default("pending") @map("status")
  /// Reason for rejection (shown to the member)
  rejectReason    String?   @map("reject_reason")
  /// Link token sent to member for registration (short-lived, 48h)
  inviteToken     String?   @unique @map("invite_token")
  /// Token expires at
  inviteExpiresAt DateTime? @map("invite_expires_at")
  /// Linked User account (null until member registers)
  userId          String?   @map("user_id")
  /// User who approved or rejected this request
  processedBy     String?   @map("processed_by")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User?     @relation("MemberRequestUser", fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([inviteToken])
  @@map("member_requests")
}

/// Audit trail for role assignments — records who approved what role for whom.
model UserRoleApproval {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  /// userId of the approver (CEO or super_admin)
  approvedBy String   @map("approved_by")
  approvedAt DateTime @default(now()) @map("approved_at")
  /// Optional note, e.g. "Approved during onboarding"
  notes      String?  @map("notes")
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_role_approvals")
}

// ── Auth / Sessions ──────────────────────────────────────────────────────────────

/// Refresh token — issued on login, rotated on use, revocable.
/// Bridges access token (short-lived, stateless) with a persistent session (revocable).
model RefreshToken {
  id         String    @id @default(cuid())
  /// SHA-256 hash of the raw refresh token value — safe for DB storage
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id")
  /// Unique session identifier embedded in both access + refresh tokens (for revocation)
  sessionId  String    @unique @default(cuid()) @map("session_id")
  /// Parsed from User-Agent, e.g. "Chrome / macOS"
  deviceType String?   @map("device_type")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  /// Revoked tokens can no longer be used for refresh
  isRevoked  Boolean   @default(false) @map("is_revoked")
  /// UTC expiry — refresh tokens valid 7 days
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Updated on every successful token refresh (rotation tracking)
  lastUsedAt DateTime? @map("last_used_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Tracks failed login attempts per email + IP for brute-force lockout.
/// After MAX_ATTEMPTS within LOOKBACK_MS, the account is locked for LOCKOUT_MS.
model LoginAttempt {
  id          String    @id @default(cuid())
  email       String    @map("email")
  ipAddress   String    @map("ip_address")
  count       Int       @default(1) @map("count")
  /// When set, all login attempts for this email are rejected until this time passes
  lockedUntil DateTime? @map("locked_until")
  lastAttempt DateTime  @default(now()) @map("last_attempt")
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?   @map("user_id")

  @@index([email, lastAttempt])
  @@index([ipAddress, lastAttempt])
  @@map("login_attempts")
}

// ── Revenue Split Config ───────────────────────────────────────────────────────

/// Admin-configurable revenue split percentages per role.
/// Example: pm=35%, dev=25%, qa=15%, design=15%, seo=10%.
/// Used by OffSystemPayment to auto-calculate LP splits.
model RevenueSplitConfig {
  id         String   @id @default(cuid())
  /// Unique key: "pm" | "dev" | "qa" | "design" | "seo" | "sales" | "company"
  key        String   @unique @map("key")
  label      String   @map("label")
  percentage Float    @default(0) @map("percentage")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("revenue_split_configs")
}

// ── Off-System Payments ───────────────────────────────────────────────────────

/// Records payments received outside the standard order system.
/// Auto-generates OffSystemSplit records based on RevenueSplitConfig.
model OffSystemPayment {
  id          String   @id @default(cuid())
  /// Optional link to an existing Order
  orderId     String?  @map("order_id")
  /// Amount in VNĐ
  amountVnd   Float    @map("amount_vnd")
  /// LP-to-VND rate at time of recording (e.g. 1000 = 1 LP = 1000 VND)
  lpRate      Float    @map("lp_rate")
  /// Computed total LP: amountVnd / lpRate
  totalLp     Int      @map("total_lp")
  description String?  @map("description")
  note        String?  @map("note")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  order  Order?           @relation(fields: [orderId], references: [id])
  splits OffSystemSplit[]

  @@index([orderId])
  @@index([createdAt])
  @@map("off_system_payments")
}

/// Per-role LP split for an OffSystemPayment.
/// Status: pending → approved (LP credited) or rejected.
model OffSystemSplit {
  id                 String    @id @default(cuid())
  offSystemPaymentId String    @map("off_system_payment_id")
  /// TeamMember who receives this LP share
  memberId           String    @map("member_id")
  /// Role this split belongs to: "pm" | "dev" | "qa" | etc.
  projectRole        String    @map("project_role")
  percentage         Float     @default(0) @map("percentage")
  lpAmount           Int       @default(0) @map("lp_amount")
  status             String    @default("pending") @map("status")
  approvedBy         String?   @map("approved_by")
  approvedAt         DateTime? @map("approved_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  offSystemPayment OffSystemPayment @relation(fields: [offSystemPaymentId], references: [id], onDelete: Cascade)
  member           TeamMember       @relation(fields: [memberId], references: [id])

  @@index([offSystemPaymentId])
  @@index([memberId])
  @@index([status])
  @@map("off_system_splits")
}

model PermissionAudit {
  id           String   @id @default(cuid())
  targetUserId String   @map("target_user_id")
  grantedBy    String   @map("granted_by")
  permission   String
  department   String?
  action       String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([targetUserId])
  @@map("permission_audits")
}

// ─── P0: FAQ ───────────────────────────────────────────────────────────────────
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String   @default("general") // general | services | technical | payment | lp | academy
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // i18n
  questionEn String? @map("question_en")
  questionJa String? @map("question_ja")
  questionKo String? @map("question_ko")
  questionZh String? @map("question_zh")
  answerEn   String? @map("answer_en") @db.Text
  answerJa   String? @map("answer_ja") @db.Text
  answerKo   String? @map("answer_ko") @db.Text
  answerZh   String? @map("answer_zh") @db.Text

  @@index([category, isActive])
  @@index([isActive, sortOrder])
  @@map("faqs")
}

// ─── P1: Careers ───────────────────────────────────────────────────────────────
model JobPosting {
  id             String    @id @default(cuid())
  title          String
  department     String // engineering | design | media | marketing | sales | finance | hr | management
  role           String // junior | mid | senior | lead | manager
  employmentType String    @default("full_time") @map("employment_type") // full_time | part_time | contract | internship
  location       String    @default("Ho Chi Minh City, Vietnam")
  salaryMin      Int?      @map("salary_min")
  salaryMax      Int?      @map("salary_max")
  salaryCurrency String    @default("VND") @map("salary_currency")
  description    String    @db.Text
  requirements   String    @db.Text
  benefits       String    @db.Text
  status         String    @default("open") @map("status") // open | closed | draft
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  expiresAt      DateTime? @map("expires_at")

  // i18n
  titleEn String? @map("title_en")
  descEn  String? @map("desc_en") @db.Text
  reqEn   String? @map("req_en") @db.Text
  benEn   String? @map("ben_en") @db.Text

  applications JobApplication[]

  @@index([status, isActive])
  @@index([department, status])
  @@index([isActive, sortOrder])
  @@map("job_postings")
}

model JobApplication {
  id           String     @id @default(cuid())
  jobPostingId String     @map("job_posting_id")
  name         String
  email        String
  phone        String?
  linkedinUrl  String?    @map("linkedin_url")
  portfolioUrl String?    @map("portfolio_url")
  coverLetter  String?    @map("cover_letter") @db.Text
  resumeUrl    String?    @map("resume_url")
  status       String     @default("applied") @map("status") // applied | screening | interview | offer | hired | rejected
  note         String?    @map("note") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([jobPostingId, status])
  @@index([status])
  @@map("job_applications")
}

// ─── P1: Contracts ─────────────────────────────────────────────────────────────
model Contract {
  id         String    @id @default(cuid())
  title      String
  orderId    String?   @map("order_id")
  customerId String?   @map("customer_id")
  status     String    @default("draft") @map("status") // draft | sent | signed | expired | cancelled
  fileUrl    String?   @map("file_url")
  value      Int? // Contract value in VND
  sentAt     DateTime? @map("sent_at")
  signedAt   DateTime? @map("signed_at")
  expiresAt  DateTime? @map("expires_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  note       String?   @map("note") @db.Text

  @@index([status])
  @@index([orderId])
  @@index([customerId])
  @@map("contracts")
}

// ─── P1: Invoices ──────────────────────────────────────────────────────────────
model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique @map("invoice_number")
  orderId       String?   @map("order_id")
  customerId    String?   @map("customer_id")
  type          String    @default("income") @map("type") // income | expense
  amount        Int
  taxAmount     Int       @default(0) @map("tax_amount")
  totalAmount   Int       @default(0) @map("total_amount")
  currency      String    @default("VND")
  status        String    @default("draft") @map("status") // draft | sent | paid | overdue | cancelled
  dueDate       DateTime? @map("due_date")
  paidAt        DateTime? @map("paid_at")
  paidMethod    String?   @map("paid_method") // bank_transfer | cash | vn_pay | momo
  description   String?   @map("description")
  note          String?   @map("note") @db.Text
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lineItems InvoiceLineItem[]

  @@index([status, type])
  @@index([orderId])
  @@index([customerId])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Int     @default(1) @map("quantity")
  unitPrice   Int     @map("unit_price")
  totalPrice  Int     @map("total_price")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Expense {
  id          String    @id @default(cuid())
  category    String // software | hardware | marketing | salary | office | travel | other
  description String
  amount      Int
  currency    String    @default("VND")
  date        DateTime  @default(now()) @map("date")
  vendor      String?
  receiptUrl  String?   @map("receipt_url")
  status      String    @default("pending") @map("status") // pending | approved | rejected | reimbursed
  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  note        String?   @map("note") @db.Text
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([category, status])
  @@index([status, date])
  @@index([date])
  @@map("expenses")
}

// ─── P2: Knowledge Base ────────────────────────────────────────────────────────
model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String   @default("general") @map("category") // engineering | design | hr | processes | general
  content     String   @db.Text
  excerpt     String?
  authorId    String?  @map("author_id")
  isPinned    Boolean  @default(false) @map("is_pinned")
  isPublished Boolean  @default(false) @map("is_published")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tags String[]

  @@index([category, isPublished])
  @@index([isPinned])
  @@map("knowledge_articles")
}

// ─── P2: Leave Request ────────────────────────────────────────────────────────
model LeaveRequest {
  id          String    @id @default(cuid())
  memberId    String    @map("member_id")
  type        String // annual | sick | unpaid | maternity | paternity | bereavement
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  days        Int       @default(1)
  reason      String?   @db.Text
  status      String    @default("pending") @map("status") // pending | approved | rejected | cancelled
  respondedBy String?   @map("responded_by")
  respondedAt DateTime? @map("responded_at")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([memberId, status])
  @@index([status])
  @@map("leave_requests")
}
