/// Google Search Console SEO metrics per project page.
model GscMetric {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id") // FK → Order.id
  pageUrl     String   @map("page_url") // e.g. https://client.com or /page-slug
  keyword     String   @default("") // tracked keyword (empty = page total)
  impressions Int      @default(0) @map("impressions")
  clicks      Int      @default(0)
  ctr         Float    @default(0) // click-through rate (0–1)
  position    Float    @default(0) // avg search position
  dataDate    DateTime @default(now()) @map("data_date") // day of data
  createdAt   DateTime @default(now()) @map("created_at")
