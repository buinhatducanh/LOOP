  project Order @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([dataDate])
  @@map("gsc_metrics")
}

/// Project handover checklist delivered to client.
model HandoverPackage {
  id           String    @id @default(cuid())
  projectId    String    @map("project_id") // FK → Order.id (kept as project_id for backward compat)
  status       String    @default("draft") @map("status") // draft | pending_review | approved | handed_over
