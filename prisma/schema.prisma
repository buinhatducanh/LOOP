  items        Json      @default("[]") @map("items") // Array of { key, label, checked, notes }
  notes        String?   @db.Text
  deliveredBy  String?   @map("delivered_by") // FK → TeamMember.id
  createdAt    DateTime  @default(now()) @map("created_at")

  project Order @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("handover_packages")
}

/// Daily standup report per team member per project.
model DailyStandup {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id") // FK → Order.id (kept as project_id for backward compat)
  memberId      String   @map("member_id") // FK → TeamMember.id
  date          DateTime @map("date")
  yesterdayDone String?  @map("yesterday_done") @db.Text
  todayPlan     String?  @map("today_plan") @db.Text
  blockers      String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  project Order      @relation(fields: [projectId], references: [id], onDelete: Cascade)
