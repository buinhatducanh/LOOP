generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id                String             @id @default(cuid())
  name              String             @unique
  displayName       String             @map("display_name")
  description       String?
  /// *
  ///    * Colour for UI badges, e.g. "red", "indigo", "amber"
  color             String             @default("slate") @map("color")
  level             Int                @default(0)
  isSystem          Boolean            @default(false) @map("is_system")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  permissions       Permission[]
  users             UserRole[]
  userRoleApprovals UserRoleApproval[]

  @@index([level])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  /// *
  ///    * "all" | "own" | comma-separated IDs
  scope       String  @default("all")
  description String?
  roleId      String  @map("role_id")
  role        Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([resource])
  @@index([roleId, action])
  @@map("permissions")
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  assignedBy String?   @map("assigned_by")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  token        String   @unique
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ipAddress String   @map("ip_address")
  userAgent String   @map("user_agent")
  location  String?
  status    String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  message   String
  data      Json?
  link      String?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AdminNotification {
  id        String    @id @default(cuid())
  type      String
  title     String
  message   String
  link      String?
  priority  String    @default("normal")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@map("admin_notifications")
}

/// Notification templates — supports i18n and admin customization.
/// Falls back to hardcoded defaults when no template exists.
model NotificationTemplate {
  id        String   @id @default(cuid())
  /// Template key matching AdminNotification.type or Notification.type
  key       String   @unique @map("template_key")
  /// UI locale code: vi | en | ja | ko | zh
  locale    String   @default("vi")
  /// Notification title — supports {{variable}} placeholders
  title     String
  /// Notification message body — supports {{variable}} placeholders
  message   String   @db.Text
  /// Whether this template is active (admin can disable per locale)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, locale])
  @@map("notification_templates")
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  name                 String
  passwordHash         String?            @map("password_hash")
  avatar               String?
  role                 String             @default("user")
  googleId             String?            @unique @map("google_id")
  isActive             Boolean            @default(true) @map("is_active")
  accountType          String             @default("customer") @map("account_type")
  /// Tracks whether customer has completed onboarding profile
  isOnboarded          Boolean            @default(false) @map("is_onboarded")
  /// Customer profile fields (used when accountType = "customer")
  phone                String?            @map("phone")
  dateOfBirth          DateTime?          @map("date_of_birth")
  companyName          String?            @map("company_name")
  /// e.g. "technology" | "retail" | "finance" | "healthcare" | "education" | "food" | "real_estate" | "manufacturing" | "services" | "other"
  businessType         String?            @map("business_type")
  address              String?            @map("address")
  taxCode              String?            @map("tax_code")
  /// Login tracking
  loginCount           Int                @default(0) @map("login_count")
  lastLogin            DateTime?          @map("last_login")
  /// Daily login streak for staff (resets to 1 if a day is missed)
  loginStreak          Int                @default(0) @map("login_streak")
  /// 2FA TOTP
  totpSecret           String?            @map("totp_secret")
  totpEnabled          Boolean            @default(false) @map("totp_enabled")
  /// Hashed backup codes (up to 8)
  totpBackupCodes      String?            @map("totp_backup_codes")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  teamMemberId         String?            @unique @map("team_member_id")
  auditLogs            AuditLog[]
  eduInstructedCourses Course[]           @relation("CourseToInstructorUser")
  courseEnrollments    Enrollment[]       @relation("EnrollmentUser")
  instructorsAsUser    Instructor?        @relation("InstructorToUser")
  loginHistory         LoginHistory[]
  loginAttempts        LoginAttempt[]
  notifications        Notification[]
  refreshTokens        RefreshToken[]
  sessions             Session[]
  userRoles            UserRole[]
  teamMember           TeamMember?        @relation(fields: [teamMemberId], references: [id])
  questParticipants    QuestParticipant[]
  memberRequests       MemberRequest[]    @relation("MemberRequestUser")
  userRoleApprovals    UserRoleApproval[]
  otps                 OtpCode[]

  reviews        ProjectReview[]
  supportTickets SupportTicket[]

  @@map("users")
}

/// OTP codes for password reset and email verification.
model OtpCode {
  id        String   @id @default(cuid())
  email     String   @map("email")
  /// Hashed OTP code (6 digits)
  code      String
  /// "password_reset" | "email_verify" | "login_otp"
  type      String   @default("password_reset")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false) @map("used")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @map("user_id")

  @@index([email, type])
  @@index([userId])
  @@map("otp_codes")
}

model Service {
  id                 String    @id @default(cuid())
  slug               String    @unique
  icon               String
  /// Cloudinary publicId for icon — used for deletion when replaced
  iconPublicId       String?   @map("icon_public_id")
  title              String
  shortDescription   String    @map("short_description")
  longDescription    String    @map("long_description")
  features           String[]
  technologies       String[]
  startingPrice      Int       @map("starting_price")
  deliveryTime       String    @map("delivery_time")
  category           String
  isActive           Boolean   @default(true) @map("is_active")
  sortOrder          Int       @default(0) @map("sort_order")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  longDescriptionEn  String?   @map("long_description_en")
  longDescriptionJa  String?   @map("long_description_ja")
  longDescriptionKo  String?   @map("long_description_ko")
  longDescriptionZh  String?   @map("long_description_zh")
  shortDescriptionEn String?   @map("short_description_en")
  shortDescriptionJa String?   @map("short_description_ja")
  shortDescriptionKo String?   @map("short_description_ko")
  shortDescriptionZh String?   @map("short_description_zh")
  titleEn            String?   @map("title_en")
  titleJa            String?   @map("title_ja")
  titleKo            String?   @map("title_ko")
  titleZh            String?   @map("title_zh")
  featuresEn         String[]  @map("features_en")
  featuresJa         String[]  @map("features_ja")
  featuresKo         String[]  @map("features_ko")
  featuresZh         String[]  @map("features_zh")
  technologiesEn     String[]  @map("technologies_en")
  technologiesJa     String[]  @map("technologies_ja")
  technologiesKo     String[]  @map("technologies_ko")
  technologiesZh     String[]  @map("technologies_zh")
  projects           Project[]

  @@map("services")
}

model ServiceTier {
  id          String   @id @default(cuid())
  serviceKey  String   @map("service_key")
  level       Int      @map("tier_level")
  name        String
  nameEn      String?  @map("name_en")
  nameJa      String?  @map("name_ja")
  nameKo      String?  @map("name_ko")
  nameZh      String?  @map("name_zh")
  shortDesc   String?  @map("short_desc")
  shortDescEn String?  @map("short_desc_en")
  shortDescJa String?  @map("short_desc_ja")
  shortDescKo String?  @map("short_desc_ko")
  shortDescZh String?  @map("short_desc_zh")
  basePrice   Int      @map("base_price")
  marketPrice Int?     @map("market_price")
  lpReward    Int      @default(50) @map("lp_reward")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([serviceKey, level])
  @@index([serviceKey, isActive])
  @@map("service_tiers")
}

model Project {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  title                String
  category             String
  client               String
  year                 String
  image                String
  imagePublicId        String?     @map("image_public_id")
  description          String
  techStack            String[]    @map("tech_stack")
  features             String[]
  results              String
  screenshots          String[]
  screenshotsPublicIds String[]    @map("gallery_public_ids")
  isPublished          Boolean     @default(true) @map("is_published")
  sortOrder            Int         @default(0) @map("sort_order")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  serviceId            String?     @map("service_id")
  teamMemberId         String?     @map("team_member_id")
  descriptionEn        String?     @map("description_en")
  descriptionJa        String?     @map("description_ja")
  descriptionKo        String?     @map("description_ko")
  descriptionZh        String?     @map("description_zh")
  resultsEn            String?     @map("results_en")
  resultsJa            String?     @map("results_ja")
  resultsKo            String?     @map("results_ko")
  resultsZh            String?     @map("results_zh")
  titleEn              String?     @map("title_en")
  titleJa              String?     @map("title_ja")
  titleKo              String?     @map("title_ko")
  titleZh              String?     @map("title_zh")
  techStackEn          String[]    @map("tech_stack_en")
  techStackJa          String[]    @map("tech_stack_ja")
  techStackKo          String[]    @map("tech_stack_ko")
  techStackZh          String[]    @map("tech_stack_zh")
  featuresEn           String[]    @map("features_en")
  featuresJa           String[]    @map("features_ja")
  featuresKo           String[]    @map("features_ko")
  featuresZh           String[]    @map("features_zh")
  service              Service?    @relation(fields: [serviceId], references: [id])
  teamMember           TeamMember? @relation(fields: [teamMemberId], references: [id])

  // Case study fields (P0 — 2026-04-11)
  isCaseStudy   Boolean  @default(false) @map("is_case_study")
  industry      String? // fintech | retail | manufacturing | healthcare | education | logistics | other
  projectScope  String? // "MVP", "Full platform", "Migration", ...
  teamSize      Int?     @map("team_size")
  duration      String? // "3 tháng", "6 tuần", ...
  challenge     String? // Business challenge
  solution      String? // Methodology & approach
  clientQuote   String?  @map("client_quote")
  clientRole    String?  @map("client_role") // "CEO", "CTO", ...
  roiMetric     String?  @map("roi_metric") // "300% ROI in 6 months"
  primaryMetric String?  @map("primary_metric") // "conversion_rate_up_45%"
  videoUrl      String?  @map("video_url")
  galleryImages String[] @map("gallery_images")

  @@map("projects")
}

model PricingPlan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  price       Int?
  period      String
  tagline     String
  features    String[]
  notIncluded String[] @map("not_included")
  highlighted Boolean  @default(false)
  cta         String   @default("Get Started")
  color       String   @default("#3B82F6")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("pricing_plans")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  avatar    String
  rating    Int      @default(5)
  text      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  companyEn String?  @map("company_en")
  companyJa String?  @map("company_ja")
  companyKo String?  @map("company_ko")
  companyZh String?  @map("company_zh")
  roleEn    String?  @map("role_en")
  roleJa    String?  @map("role_ja")
  roleKo    String?  @map("role_ko")
  roleZh    String?  @map("role_zh")
  textEn    String?  @map("text_en")
  textJa    String?  @map("text_ja")
  textKo    String?  @map("text_ko")
  textZh    String?  @map("text_zh")

  @@map("testimonials")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_messages")
}

model TeamMember {
  id                 String      @id @default(cuid())
  slug               String      @unique
  name               String
  role               String
  /// Department: engineering/design/media/marketing/sales/finance/hr/management
  department         String      @default("engineering") @map("department")
  departmentId       String?     @map("department_id")
  departmentRelation Department? @relation(fields: [departmentId], references: [id])
  tabPermissions     String[]    @default([]) @map("tab_permissions")
  /// Chức danh — do HR/Admin nhập tay (VD: "Lập trình viên", "Senior Designer")
  position           String?
  /// Access tags granted by CEO during onboarding
  accessTags         String[]    @default([]) @map("access_tags")
  /// Onboarding status: pending = waiting CEO approval, approved = active
  requestStatus      String      @default("approved") @map("request_status")
  bio                String?
  shortBio           String?     @map("short_bio")
  imagePublicId      String?     @map("image_public_id")
  image              String?
  achievements       String[]
  linkedin           String?
  twitter            String?
  github             String?
  sortOrder          Int         @default(0) @map("sort_order")
  isActive           Boolean     @default(true) @map("is_active")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  roleLevel          Int         @default(4) @map("role_level")
  coverImagePublicId String?     @map("cover_image_public_id")
  coverImage         String?     @map("cover_image")
  quote              String?
  email              String?     @unique
  phone              String?
  skills             String[]
  experience         String?
  social             Json?
  isWorking          Boolean     @default(true) @map("is_working")
  isFeatured         Boolean     @default(false) @map("is_featured")
  birthDate          DateTime?   @map("birth_date")
  address            String?     @map("address")
  cccd               String?     @map("cccd")
  contractStart      DateTime?   @map("contract_start")
  joinedDate         DateTime?   @map("joined_date")
  experienceFrom     Int?        @map("experience_from")
  facebook           String?     @map("facebook")
  tiktok             String?     @map("tiktok")

  // Banking off-system info
  bankName               String?                @map("bank_name")
  bankAccount            String?                @map("bank_account")
  bankAccountName        String?                @map("bank_account_name")
  currentXp              Int                    @default(0) @map("current_xp")
  level                  Int                    @default(1) @map("level")
  /// Tổng LP commission đã nhận
  totalSalesCommission   Int                    @default(0) @map("total_sales_commission")
  /// LP commission đang chờ (chưa done)
  pendingCommission      Int                    @default(0) @map("pending_commission")
  /// LP commission đã nhận (done)
  completedCommission    Int                    @default(0) @map("completed_commission")
  maxXp                  Int                    @default(100) @map("max_xp")
  rank                   String                 @default("iron") @map("rank")
  availableLp            Int                    @default(0) @map("available_lp")
  lockedLp               Int                    @default(0) @map("locked_lp")
  bioEn                  String?                @map("bio_en")
  bioJa                  String?                @map("bio_ja")
  bioKo                  String?                @map("bio_ko")
  bioZh                  String?                @map("bio_zh")
  nameEn                 String?                @map("name_en")
  nameJa                 String?                @map("name_ja")
  nameKo                 String?                @map("name_ko")
  nameZh                 String?                @map("name_zh")
  roleEn                 String?                @map("role_en")
  roleJa                 String?                @map("role_ja")
  roleKo                 String?                @map("role_ko")
  roleZh                 String?                @map("role_zh")
  shortBioEn             String?                @map("short_bio_en")
  shortBioJa             String?                @map("short_bio_ja")
  shortBioKo             String?                @map("short_bio_ko")
  shortBioZh             String?                @map("short_bio_zh")
  blogPostsAuthored      BlogPost[]
  bugNotesAuthored       BugNote[]              @relation("BugNoteAuthor")
  eduCourses             Course[]               @relation("CourseToInstructorMember")
  dailyStandups          DailyStandup[]
  enrollments            Enrollment[]           @relation("EnrollmentTeamMember")
  envFileEdits           EnvFile[]              @relation("EnvFileEditor")
  instructorProfile      Instructor?
  lpAwardsApproved       LpAward[]              @relation("LpAwardApprover")
  lpAwardsReceived       LpAward[]              @relation("LpAwardMember")
  lpRedemptions          LpRedemption[]
  lpTransactionsReceived LpTransaction[]        @relation("LpTransactionCounterparty")
  lpTransactionsCreated  LpTransaction[]        @relation("LpTransactionCreator")
  lpTransactions         LpTransaction[]
  mediaBookings          MediaBooking[]
  memberExpertise        MemberExpertise[]
  effectOverrides        MemberEffectOverride[] @relation("MemberEffectOverrides")
  projectMemberships     ProjectMember[]
  projects               Project[]
  referralCodes          ReferralCode[]
  assignedTasks          Task[]                 @relation("TaskAssignee")
  user                   User?
  offSystemSplits        OffSystemSplit[]
  /// Sales commission events (audit trail)
  salesCommissionEvents  SalesCommissionEvent[] @relation("SalesCommissionMember")
  /// Multi-department: member co the tham gia nhieu phong ban cung luc
  memberDepartments      MemberDepartment[]
  mediaStoriesAuthored   MediaStory[]               @relation("MediaStoryAuthor")

  @@index([departmentId])
  @@index([isActive])
  @@index([rank])
  @@index([requestStatus])
  @@index([departmentId, isActive])
  @@index([rank, isActive])
  @@map("team_members")
}

model Division {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  shortName   String
  color       String       @default("#3B82F6")
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  departments Department[]

  @@index([key])
  @@map("divisions")
}

model Department {
  id          String   @id @default(cuid())
  key         String?  @unique
  name        String?
  shortName   String?
  color       String?
  description String?
  mission     String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  divisionId  String?   @map("division_id")
  division    Division? @relation(fields: [divisionId], references: [id])
  memberDepartments MemberDepartment[]
  members           TeamMember[]
  quests            Quest[]

  @@index([divisionId])
  @@map("departments")
}

/// Junction table: thành viên có thể thuộc nhiều phòng ban
/// departmentId = phòng ban tham gia (nullable = chưa phân phòng)
model MemberDepartment {
  id           String      @id @default(cuid())
  memberId     String      @map("member_id")
  member       TeamMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Chức danh trong phòng ban này — do HR/Admin nhập
  position     String?
  /// Trưởng phòng = đúng 1 member có isDeptHead=true trong phòng
  isDeptHead   Boolean     @default(false) @map("is_dept_head")
  /// Phòng ban này là primary (hiển thị chính)
  isPrimary    Boolean     @default(false) @map("is_primary")
  joinedAt     DateTime    @default(now()) @map("joined_at")

  @@unique([memberId, departmentId])
  @@index([memberId])
  @@index([departmentId])
  @@map("member_departments")
}

model Expertise {
  id              String            @id @default(cuid())
  name            String
  category        String
  icon            String?
  logo            String?
  isActive        Boolean           @default(true) @map("is_active")
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  categoryEn      String?           @map("category_en")
  categoryJa      String?           @map("category_ja")
  categoryKo      String?           @map("category_ko")
  categoryZh      String?           @map("category_zh")
  nameEn          String?           @map("name_en")
  nameJa          String?           @map("name_ja")
  nameKo          String?           @map("name_ko")
  nameZh          String?           @map("name_zh")
  memberExpertise MemberExpertise[]

  @@index([category, isActive])
  @@index([isActive, sortOrder])
  @@map("expertises")
}

model MemberExpertise {
  id          String     @id @default(cuid())
  memberId    String     @map("member_id")
  expertiseId String     @map("expertise_id")
  level       Int        @default(5)
  createdAt   DateTime   @default(now()) @map("created_at")
  expertise   Expertise  @relation(fields: [expertiseId], references: [id], onDelete: Cascade)
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, expertiseId])
  @@map("member_expertises")
}

model ServicePackage {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  title                  String
  titleEn                String?        @map("title_en")
  titleJa                String?        @map("title_ja")
  titleKo                String?        @map("title_ko")
  titleZh                String?        @map("title_zh")
  shortDesc              String         @map("short_desc")
  shortDescEn            String?        @map("short_desc_en")
  shortDescJa            String?        @map("short_desc_ja")
  shortDescKo            String?        @map("short_desc_ko")
  shortDescZh            String?        @map("short_desc_zh")
  type                   String
  price                  Int?
  priceText              String?        @map("price_text")
  features               String[]
  isSubscription         Boolean        @default(false) @map("is_subscription")
  billingPeriod          String?        @map("billing_period")
  sortOrder              Int            @default(0) @map("sort_order")
  isActive               Boolean        @default(true) @map("is_active")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  /// Maps this package to a ServiceTier: "web" | "app" | "dashboard" | "seo"
  serviceKey             String?        @map("service_key")
  /// Tier level: 1=Basic, 2=Business, 3=Experience — matches ServiceTier.level
  tierLevel              Int            @default(1) @map("tier_level")
  videoUrl               String?        @map("video_url")
  videoThumbnail         String?        @map("video_thumbnail")
  showFeatureAcknowledge Boolean        @default(true) @map("show_feature_acknowledge")
  acknowledgmentItems    Json?          @map("acknowledgment_items")
  /// Tagline hiển thị trên card gói (mô tả ngắn)
  tagline                String?        @map("tagline")
  /// Màu chủ đạo của gói (hex)
  color                  String?        @map("color")
  /// Số trang mặc định
  pages                  String?        @map("pages")
  pagesVi                String?        @map("pages_vi")
  /// Giá gốc (để tính % tiết kiệm hiển thị)
  marketPrice            Int?           @map("market_price")
  /// Đánh dấu gói phổ biến
  isPopular              Boolean        @default(false) @map("is_popular")
  mediaBookings          MediaBooking[]
  orders                 Order[]

  @@map("service_packages")
}

model Order {
  id                    String                 @id @default(cuid())
  orderNumber           String                 @unique @map("order_number")
  orderType             String                 @default("package") @map("order_type")
  packageId             String?                @map("package_id")
  templateId            String?                @map("template_id")
  customerName          String                 @map("customer_name")
  customerEmail         String                 @map("customer_email")
  customerPhone         String?                @map("customer_phone")
  companyName           String?                @map("company_name")
  requirements          String?
  brandGuidelines       String?                @map("brand_guidelines")
  status                String                 @default("pending")
  paymentStatus         String                 @default("unpaid") @map("payment_status")
  totalAmount           Int?                   @map("total_amount")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  basePrice             Int?                   @map("base_price")
  systemCalculatedPrice Int?                   @map("system_calculated_price")
  adminOverridePrice    Int?                   @map("admin_override_price")
  adminPriceNote        String?                @map("admin_price_note")
  finalPrice            Int?                   @map("final_price")
  totalXp               Int                    @default(0) @map("total_xp")
  rewardLevel           Int                    @default(1) @map("reward_level")
  paymentMethod         String?                @map("payment_method")
  paidAmount            Int                    @default(0) @map("paid_amount")
  domainName            String?                @map("domain_name")
  completedAt           DateTime?              @map("completed_at")
  gitRepoUrl            String?                @map("git_repo_url")
  gitWebhookSecret      String?                @map("git_webhook_secret")
  isActiveProject       Boolean                @default(false) @map("is_active_project")
  projectStatus         String?                @map("project_status")
  seoMaxLp              Int                    @default(100) @map("seo_max_lp")
  startedAt             DateTime?              @map("started_at")
  totalProjectLp        Int                    @default(0) @map("total_project_lp")
  salesLeadId           String?                @map("sales_lead_id")
  /// *
  ///    * Referral code used to create this order
  referralCodeId        String?                @map("referral_code_id")
  /// *
  ///    * Infrastructure tier (Basic/Pro/Enterprise) applied to this order
  infrastructureTierId  String?                @map("infrastructure_tier_id")
  /// *
  ///    * LP allocation from quote (% per role) — used to distribute LP when order is paid
  lpAllocation          Json?                  @map("lp_allocation")
  /// LP used by customer to offset totalAmount (captured from QuoteRequest)
  lpUsed                Int                    @default(0) @map("lp_used")
  /// LP reward to customer on order completion (manual entry by admin/PM)
  lpReward              Int                    @default(0) @map("lp_reward")
  backlogs              Backlog[]
  blogPosts             BlogPost[]
  customerWebsites      CustomerWebsite[]
  mediaBookings         MediaBooking[]
  dailyStandups         DailyStandup[]
  deployments           Deployment[]
  envFiles              EnvFile[]
  epics                 Epic[]
  figmaDemos            FigmaDemo[]
  gitCommits            GitCommit[]
  gscMetrics            GscMetric[]
  handoverPackages      HandoverPackage[]
  lpAwards              LpAward[]
  maintenanceContracts  MaintenanceContract[]
  selectedAttributes    OrderAttribute[]
  orderRewards          OrderReward[]
  statusHistory         OrderStatusHistory[]
  infrastructureTier    InfrastructureTier?    @relation("OrderInfrastructure", fields: [infrastructureTierId], references: [id])
  package               ServicePackage?        @relation(fields: [packageId], references: [id])
  referralCode          ReferralCode?          @relation("ReferralCodeOrders", fields: [referralCodeId], references: [id])
  salesLead             SalesLead?             @relation(fields: [salesLeadId], references: [id])
  template              WebTemplate?           @relation(fields: [templateId], references: [id])
  payments              Payment[]
  projectMembers        ProjectMember[]
  portalTokens          ProjectPortalToken[]
  quotes                Quote[]
  slaRules              SlaRule[]
  socialPosts           SocialPost[]
  offSystemPayments     OffSystemPayment[]
  taskKanbans           TaskKanban[]
  externalProject       ExternalProject?       @relation("OrderExternalProject", fields: [externalProjectId], references: [id])
  externalProjectId     String?                @unique @map("external_project_id")
  salesRepId            String?                @map("sales_rep_id")
  /// LP earned from main service (10% direct commission)
  salesDirectCommission Int                    @default(0) @map("sales_direct_commission")
  /// LP earned from addons (5% addon commission)
  salesAddonCommission  Int                    @default(0) @map("sales_addon_commission")
  /// Whether commission has been credited to salesRep
  commissionPaid        Boolean                @default(false) @map("commission_paid")
  /// When commission was credited
  commissionPaidAt      DateTime?              @map("commission_paid_at")
  /// Sales commission events for this order
  salesCommissionEvents SalesCommissionEvent[] @relation("SalesCommissionOrder")
  reviews               ProjectReview[]
  supportTickets        SupportTicket[]
  orderRevenueLines     OrderRevenueLine[]

  @@index([status, createdAt])
  @@index([orderType, status])
  @@index([customerEmail])
  @@index([referralCodeId])
  @@map("orders")
}

/// ProjectReview — customer reviews of completed orders
model ProjectReview {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  userId    String   @map("user_id")
  rating    Int
  title     String?
  comment   String?
  aspects   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, userId])
  @@index([userId])
  @@index([orderId])
  @@map("project_reviews")
}

/// SupportTicket — customer support tickets
model SupportTicket {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  orderId     String?  @map("order_id")
  subject     String
  description String
  priority    String   @default("normal")
  status      String   @default("open")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("support_tickets")
}

/// OrderRevenueLine — VAT/tax line items for orders (domain, hosting, web packages)
model OrderRevenueLine {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  category     String
  serviceName  String   @map("service_name")
  packageRef   String?  @map("package_ref")
  quantity     Int      @default(1)
  unitPrice    Float    @map("unit_price")
  totalPrice   Float    @map("total_price")
  periodMonths Int?     @map("period_months")
  taxable      Boolean  @default(true)
  taxRate      Float    @default(0) @map("tax_rate")
  taxAmount    Float    @default(0) @map("tax_amount")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([category])
  @@map("order_revenue_lines")
}

/// ExternalProject — dự án tiếp nhận từ bên ngoài hệ thống (ký HĐ bên ngoài / sales mua hộ)
/// Gắn với Order qua externalProjectId; Order có isActiveProject = true thì Kanban hoạt động.
model ExternalProject {
  id            String    @id @default(cuid())
  /// "external" = ký kết ngoài hệ thống; "sales_assisted" = sales mua hộ cho KH
  type          String    @default("external") @map("type")
  orderId       String?   @unique @map("order_id")
  /// Thông tin hợp đồng bên ngoài
  contractRef   String?   @map("contract_ref")
  contractParty String?   @map("contract_party")
  signedAt      DateTime? @map("signed_at")
  /// Thông tin khách hàng (lưu lại để tạo Order)
  customerName  String
  customerEmail String
  customerPhone String?
  companyName   String?
  requirements  String?
  /// Giá (optional — external project có thể chưa có giá)
  totalAmount   Int?
  /// Ghi chú riêng của sales (cho sales_assisted)
  salesNote     String?   @map("sales_note")
  /// active | pending_approval | paused | completed | cancelled
  status        String    @default("active") @map("status")
  /// Ai tạo
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  order Order? @relation("OrderExternalProject")

  @@index([type])
  @@index([status])
  @@index([orderId])
  @@map("external_projects")
}

/// Infrastructure tier: determines the base hosting/ops cost component of an order.
/// Tiers are mutually exclusive per order. Examples: Basic (VPS), Pro (Cloud), Enterprise (Dedicated).
model InfrastructureTier {
  id            String   @id @default(cuid())
  slug          String   @unique @map("slug")
  name          String
  nameVi        String   @map("name_vi")
  nameEn        String?  @map("name_en")
  nameJa        String?  @map("name_ja")
  nameKo        String?  @map("name_ko")
  nameZh        String?  @map("name_zh")
  /// *
  ///    * Monthly cost in VND for this tier. Used in pricing formula.
  monthlyCost   Int      @map("monthly_cost")
  /// *
  ///    * Setup fee in VND (one-time).
  setupCost     Int      @default(0) @map("setup_cost")
  /// *
  ///    * Description shown in the pricing calculator
  description   String?
  descriptionVi String?  @map("description_vi")
  descriptionEn String?  @map("description_en")
  descriptionJa String?  @map("description_ja")
  descriptionKo String?  @map("description_ko")
  descriptionZh String?  @map("description_zh")
  /// *
  ///    * Icon name (lucide-react) for the UI
  icon          String?
  /// *
  ///    * Color for the UI badge
  color         String   @default("#6366F1")
  /// *
  ///    * Display order in the calculator
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  orders        Order[]  @relation("OrderInfrastructure")
  quotes        Quote[]

  @@map("infrastructure_tiers")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  group String @default("general")
  type  String @default("string") @map("type")

  @@map("site_settings")
}

/// Project-level role for a TeamMember assigned to an Order project.
/// Keys: pm | designer | dev | qa | seo
/// Seeded on first run. FK used by ProjectMember.projectRoleKey.
model ProjectRole {
  id        String          @id @default(cuid())
  key       String          @unique @map("key")
  label     String
  color     String          @default("#3B82F6")
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  members   ProjectMember[]

  @@index([key])
  @@map("project_roles")
}

/// A TeamMember assigned to an Order project with a specific projectRoleKey.
model ProjectMember {
  id             String      @id @default(cuid())
  memberId       String      @map("member_id")
  projectRoleKey String      @map("project_role_key")
  assignedLp     Int         @default(0) @map("assigned_lp")
  earnedLp       Int         @default(0) @map("earned_lp")
  joinedAt       DateTime    @default(now()) @map("joined_at")
  exp            Int         @default(0)
  projectId      String      @map("project_id")
  member         TeamMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project        Order       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRole    ProjectRole @relation(fields: [projectRoleKey], references: [key])

  @@unique([projectId, memberId])
  @@index([projectId])
  @@index([memberId])
  @@index([projectRoleKey])
  @@map("project_members")
}

/// Task-level Kanban board per Order project.
/// Mirrors the 5-column flow: backlog → todo → in_progress → in_review → done.
/// Auto-awards LP on "done" transition. Linked to GitHub branch via branchName.
model TaskKanban {
  id          String    @id @default(cuid())
  orderId     String    @map("order_id")
  column      String    @default("backlog") @map("column")
  title       String
  description String?   @map("description")
  priority    String    @default("medium") @map("priority")
  lp          Int       @default(0) @map("lp")
  branchName  String?   @map("branch_name")
  githubLink  String?   @map("github_link")
  assigneeId  String?   @map("assignee_id")
  qaId        String?   @map("qa_id")
  envFileId   String?   @map("env_file_id")
  completedAt DateTime? @map("completed_at")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, column])
  @@index([assigneeId])
  @@index([qaId])
  @@map("task_kanban")
}

model HomeSlider {
  id            String   @id @default(cuid())
  image         String
  imagePublicId String?  @map("image_public_id")
  title         String?
  subtitle      String?
  link          String?
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  subtitleEn    String?  @map("subtitle_en")
  subtitleJa    String?  @map("subtitle_ja")
  subtitleKo    String?  @map("subtitle_ko")
  subtitleZh    String?  @map("subtitle_zh")
  titleEn       String?  @map("title_en")
  titleJa       String?  @map("title_ja")
  titleKo       String?  @map("title_ko")
  titleZh       String?  @map("title_zh")

  @@map("home_sliders")
}

model HomeVideo {
  id                String   @id @default(cuid())
  videoUrl          String
  thumbnail         String?
  thumbnailPublicId String?  @map("thumbnail_public_id")
  title             String?
  description       String?
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("home_videos")
}

model ServiceAttribute {
  id                 String                 @id @default(cuid())
  slug               String                 @unique
  name               String
  nameVi             String                 @map("name_vi")
  nameEn             String?                @map("name_en")
  nameJa             String?                @map("name_ja")
  nameKo             String?                @map("name_ko")
  nameZh             String?                @map("name_zh")
  description        String?
  descriptionVi      String?                @map("description_vi")
  category           String
  categoryVi         String                 @map("category_vi")
  categoryEn         String?                @map("category_en")
  categoryJa         String?                @map("category_ja")
  categoryKo         String?                @map("category_ko")
  categoryZh         String?                @map("category_zh")
  icon               String?
  price              Int                    @default(0)
  isRequired         Boolean                @default(false) @map("is_required")
  sortOrder          Int                    @default(0) @map("sort_order")
  isActive           Boolean                @default(true) @map("is_active")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  tier               String                 @default("basic")
  xpPoints           Int                    @default(0) @map("xp_points")
  parentId           String?                @map("parent_id")
  /// If true, this feature is included in the base price (3,890,000₫).
  /// Appears in the feature table with price 0đ and "✓ Đã bao gồm" badge.
  includedInBase     Boolean                @default(false) @map("included_in_base")
  /// If true, this feature is an upgrade from a base feature.
  /// Appears in the "Nâng cấp" section with upgrade delta pricing.
  /// Only applies when parentId is set (i.e., this is a child of another feature).
  isUpgradeable      Boolean                @default(false) @map("is_upgradeable")
  /// Scopes this attribute to a specific service: "web" | "app" | "dashboard" | "seo". null = shared (applies to all).
  serviceKey         String?                @map("service_key")
  /// URL video hướng dẫn tính năng (YouTube/Vimeo/etc.)
  videoUrl           String?                @map("video_url")
  /// JSON array of tier levels that include this feature, e.g. "[1,2,3]".
  /// Used by SEO feature matrix: which paid SEO tiers include this feature.
  includedTiers      String?                @map("included_tiers")
  orderAttributes    OrderAttribute[]
  parent             ServiceAttribute?      @relation("FeatureHierarchy", fields: [parentId], references: [id])
  children           ServiceAttribute[]     @relation("FeatureHierarchy")
  templateAttributes WebTemplateAttribute[]

  @@index([tier, isActive])
  @@index([category, tier])
  @@index([parentId])
  @@index([includedInBase, tier])
  @@map("service_attributes")
}

model WebTemplate {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  name                 String
  nameVi               String                 @map("name_vi")
  descriptionVi        String?                @map("description_vi")
  category             String
  categoryVi           String                 @map("category_vi")
  thumbnailPublicId    String?                @map("thumbnail_public_id")
  screenshotsPublicIds String[]               @map("screenshots_public_ids")
  thumbnail            String
  screenshots          String[]
  demoUrl              String                 @map("demo_url")
  price                Int
  originalPrice        Int?                   @map("original_price")
  currency             String                 @default("VND")
  technologies         String[]
  deliveryTime         String                 @map("delivery_time")
  highlighted          Boolean                @default(false)
  sortOrder            Int                    @default(0) @map("sort_order")
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  level                Int                    @default(1)
  levelLabel           String?                @map("level_label")
  levelLabelVi         String?                @map("level_label_vi")
  orders               Order[]
  bundledAttributes    WebTemplateAttribute[]

  @@index([level, isActive])
  @@index([category, isActive])
  @@map("web_templates")
}

model WebTemplateAttribute {
  id          String           @id @default(cuid())
  templateId  String           @map("template_id")
  attributeId String           @map("attribute_id")
  attribute   ServiceAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  template    WebTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, attributeId])
  @@map("web_template_attributes")
}

model OrderAttribute {
  id           String           @id @default(cuid())
  orderId      String           @map("order_id")
  attributeId  String           @map("attribute_id")
  priceAtOrder Int              @map("price_at_order")
  attribute    ServiceAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, attributeId])
  @@map("order_attributes")
}

/// A unique referral code assigned to a staff member (referrer).
/// Codes are created by admins; each member can have multiple active codes per campaign.
model ReferralCode {
  id         String             @id @default(cuid())
  /// *
  ///    * Unique human-readable code, e.g. "THANGDEV", "LOOP-AI-2026"
  code       String             @unique @map("code")
  /// *
  ///    * Display name, e.g. "Thang Dev - 2026 Campaign"
  name       String
  /// *
  ///    * Staff member who earns LP when referrals convert
  memberId   String             @map("member_id")
  /// *
  ///    * Optional campaign label, e.g. "2026-Q1", "Summer Promo"
  campaign   String?
  /// *
  ///    * VND revenue threshold for this tier. Referrer LP = floor(totalRevenue × tierRate).
  minRevenue Int                @default(0) @map("min_revenue")
  maxRevenue Int?               @map("max_revenue")
  /// *
  ///    * LP reward rate for this tier. Example: 0.10 = 10% of referral revenue in LP for referrer.
  lpRate     Float              @default(0.05) @map("lp_rate")
  /// *
  ///    * Number of uses / max uses (null = unlimited).
  useCount   Int                @default(0) @map("use_count")
  maxUses    Int?               @map("max_uses")
  isActive   Boolean            @default(true) @map("is_active")
  expiresAt  DateTime?          @map("expires_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  orders     Order[]            @relation("ReferralCodeOrders")
  member     TeamMember         @relation(fields: [memberId], references: [id])
  tracking   ReferralTracking[]
  leads      SalesLead[]        @relation("ReferralCodeLeads")

  @@index([memberId])
  @@index([campaign])
  @@map("referral_codes")
}

/// Tracks every click / signup / order attributed to a referral code.
model ReferralTracking {
  id             String       @id @default(cuid())
  referralCodeId String       @map("referral_code_id")
  /// *
  ///    * Event type: click | signup | lead | order
  event          String
  /// *
  ///    * The landing page URL that was visited
  landingUrl     String?      @map("landing_url")
  /// *
  ///    * Visitor UTM parameters (stored as JSON)
  utmSource      String?      @map("utm_source")
  utmMedium      String?      @map("utm_medium")
  utmCampaign    String?      @map("utm_campaign")
  utmTerm        String?      @map("utm_term")
  utmContent     String?      @map("utm_content")
  /// *
  ///    * Visitor IP (hashed for privacy)
  ipHash         String?      @map("ip_hash")
  /// *
  ///    * Visitor user-agent
  userAgent      String?      @map("user_agent")
  /// *
  ///    * Attributed SalesLead ID (if event = lead or order)
  salesLeadId    String?      @map("sales_lead_id")
  /// *
  ///    * Attributed Order ID (if event = order)
  orderId        String?      @map("order_id")
  /// *
  ///    * Revenue in VND for order events
  revenue        Int          @default(0)
  /// *
  ///    * LP awarded to referrer for this conversion
  lpAwarded      Int          @default(0) @map("lp_awarded")
  createdAt      DateTime     @default(now()) @map("created_at")
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id])

  @@index([referralCodeId, event])
  @@index([referralCodeId])
  @@index([createdAt])
  @@map("referral_tracking")
}

/// Customer leads tracked through the sales pipeline.
model SalesLead {
  id              String        @id @default(cuid())
  source          String        @default("website")
  customerName    String        @map("customer_name")
  customerEmail   String?       @map("customer_email")
  customerPhone   String?       @map("customer_phone")
  companyName     String?       @map("company_name")
  area            String        @default("can_tho")
  tier            String        @default("sme")
  status          String        @default("new")
  note            String?
  estimatedBudget Int?          @map("estimated_budget")
  assignedTo      String?       @map("assigned_to")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  /// *
  ///    * Referral code used to create this lead
  referralCodeId  String?       @map("referral_code_id")
  orders          Order[]
  quotes          Quote[]
  referralCode    ReferralCode? @relation("ReferralCodeLeads", fields: [referralCodeId], references: [id])

  @@index([status, area])
  @@index([assignedTo])
  @@index([referralCodeId])
  @@map("sales_leads")
}

/// Internal sales quote with LP allocation per team role.
model Quote {
  id                     String              @id @default(cuid())
  salesLeadId            String              @map("sales_leads_id")
  orderId                String?             @map("order_id")
  quoteNumber            String              @unique @map("quote_number")
  title                  String
  totalAmount            Int                 @map("total_amount")
  lpAllocation           Json                @default("{}") @map("lp_allocation")
  status                 String              @default("draft")
  validUntil             DateTime?           @map("valid_until")
  sentAt                 DateTime?           @map("sent_at")
  approvedAt             DateTime?           @map("approved_at")
  signedAt               DateTime?           @map("signed_at")
  milestones             Json?               @map("milestones")
  note                   String?
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  /// *
  ///    * Infrastructure tier ID snapshot at time of quote
  infrastructureTierId   String?             @map("infrastructure_tier_id")
  /// *
  ///    * Infrastructure tier slug (e.g. "basic", "pro", "enterprise") for auto-pricing
  infrastructureTierSlug String?             @map("infrastructure_tier_slug")
  /// *
  ///    * Selected advanced feature IDs for auto-pricing
  selectedFeatureIds     Json?               @default("[]") @map("selected_feature_ids")
  /// LP used by customer to offset totalAmount (copied from QuoteRequest at quote creation)
  lpUsed                 Int                 @default(0) @map("lp_used")
  /// Links this quote to the originating QuoteRequest (set when admin creates quote from a wizard submission)
  quoteRequestId         String?             @unique @map("quote_request_id")
  infrastructureTier     InfrastructureTier? @relation(fields: [infrastructureTierId], references: [id])
  order                  Order?              @relation(fields: [orderId], references: [id])
  salesLead              SalesLead           @relation(fields: [salesLeadId], references: [id])
  quoteRequest           QuoteRequest?       @relation(fields: [quoteRequestId], references: [id])

  @@index([salesLeadId])
  @@index([orderId])
  @@index([status])
  @@index([infrastructureTierId])
  @@index([quoteRequestId])
  @@map("quotes")
}

model FeatureGroup {
