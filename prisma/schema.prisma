generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── RBAC ────────────────────────────────────────────────────────

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  displayName String       @map("display_name")
  description String?
  /**
   * Colour for UI badges, e.g. "red", "indigo", "amber"
   */
  color       String       @default("slate") @map("color")
  level       Int          @default(0)
  isSystem    Boolean      @default(false) @map("is_system")
  permissions Permission[]
  users       UserRole[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([level])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  /**
   * "all" | "own" | comma-separated IDs
   */
  scope       String  @default("all")
  description String?
  roleId      String  @map("role_id")
  role        Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([resource])
  @@index([roleId, action])
  @@map("permissions")
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String    @map("role_id")
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy String?   @map("assigned_by") // Admin user ID who assigned this role
  expiresAt  DateTime? @map("expires_at") // Optional expiration
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── AUTH & SESSIONS ─────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String   @map("ip_address")
  userAgent String   @map("user_agent")
  location  String?
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("login_history")
}

// ─── AUDIT & NOTIFICATIONS ──────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  data      Json?
  link      String?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── USERS ──────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?  @map("password_hash")
  avatar       String?
  role         String   @default("user")
  googleId     String?  @unique @map("google_id")
  isActive     Boolean  @default(true) @map("is_active")
  accountType  String   @default("customer") @map("account_type") // "staff" | "customer"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Linked team member profile (for staff accounts)
  teamMemberId String?     @unique @map("team_member_id")
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  // EDU relations
  courseEnrollments    Enrollment[] @relation("EnrollmentUser")
  /**
   * Instructors where this user is linked (via Instructor.userId)
   */
  instructorsAsUser    Instructor[] @relation("InstructorToUser")
  /**
   * Courses instructed by this user (via Course.instructorUserId)
   */
  eduInstructedCourses Course[]     @relation("CourseToInstructorUser")

  // Relations
  userRoles     UserRole[]
  sessions      Session[]
  loginHistory  LoginHistory[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("users")
}

// ─── CONTENT ────────────────────────────────────────────────────

model Service {
  id               String    @id @default(cuid())
  slug             String    @unique
  icon             String

  // ── Primary content (Vietnamese — source of truth) ───────────────────────────
  title            String
  shortDescription String    @map("short_description")
  longDescription  String    @map("long_description")

  // ── Translations ───────────────────────────────────────────────────────────
  titleEn          String?   @map("title_en")
  titleJa          String?   @map("title_ja")
  titleKo          String?   @map("title_ko")
  titleZh          String?   @map("title_zh")

  shortDescriptionEn String? @map("short_description_en")
  shortDescriptionJa String? @map("short_description_ja")
  shortDescriptionKo String? @map("short_description_ko")
  shortDescriptionZh String? @map("short_description_zh")

  longDescriptionEn  String? @map("long_description_en")
  longDescriptionJa  String? @map("long_description_ja")
  longDescriptionKo  String? @map("long_description_ko")
  longDescriptionZh  String? @map("long_description_zh")

  // ── Non-translatable fields ───────────────────────────────────────────────
  features         String[]
  technologies     String[]
  startingPrice    Int       @map("starting_price")
  deliveryTime     String    @map("delivery_time")
  category         String
  isActive         Boolean   @default(true) @map("is_active")
  sortOrder        Int       @default(0) @map("sort_order")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  projects         Project[]

  @@map("services")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique

  // ── Primary content (Vietnamese) ───────────────────────────────────────────────
  title       String
  category    String
  client      String
  year        String
  image       String
  description String
  techStack   String[] @map("tech_stack")
  features    String[]
  results     String
  screenshots String[]

  // ── Translations ───────────────────────────────────────────────────────────
  titleEn          String? @map("title_en")
  titleJa          String? @map("title_ja")
  titleKo          String? @map("title_ko")
  titleZh          String? @map("title_zh")

  descriptionEn    String? @map("description_en")
  descriptionJa    String? @map("description_ja")
  descriptionKo    String? @map("description_ko")
  descriptionZh    String? @map("description_zh")

  resultsEn        String? @map("results_en")
  resultsJa        String? @map("results_ja")
  resultsKo        String? @map("results_ko")
  resultsZh        String? @map("results_zh")

  // ── Non-translatable fields ───────────────────────────────────────────────
  isPublished Boolean  @default(true) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  serviceId   String?  @map("service_id")
  service     Service? @relation(fields: [serviceId], references: [id])

  // Team member who worked on this project
  teamMemberId String?     @map("team_member_id")
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id])

  @@map("projects")
}

model PricingPlan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  price       Int?
  period      String
  tagline     String
  features    String[]
  notIncluded String[] @map("not_included")
  highlighted Boolean  @default(false)
  cta         String   @default("Get Started")
  color       String   @default("#3B82F6")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("pricing_plans")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  avatar    String
  rating    Int      @default(5)
  text      String

  // ── Translations ───────────────────────────────────────────────────────────
  textEn   String? @map("text_en")
  textJa   String? @map("text_ja")
  textKo   String? @map("text_ko")
  textZh   String? @map("text_zh")

  roleEn   String? @map("role_en")
  roleJa   String? @map("role_ja")
  roleKo   String? @map("role_ko")
  roleZh   String? @map("role_zh")

  companyEn String? @map("company_en")
  companyJa String? @map("company_ja")
  companyKo String? @map("company_ko")
  companyZh String? @map("company_zh")

  // ── Non-translatable fields ───────────────────────────────────────────────
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_messages")
}

model TeamMember {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  role         String
  bio          String?  @db.Text
  shortBio     String?  @map("short_bio")
  image        String?
  achievements String[]
  linkedin     String?
  twitter      String?
  github       String?
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // ── Role Hierarchy & Premium Fields ──
  roleLevel  Int      @default(4) @map("role_level") // 0=CEO, 1=CTO/VP, 2=Lead, 3=Senior, 4=Member
  coverImage String?  @map("cover_image") // Large cover image for detail page
  quote      String? // Personal quote/slogan
  email      String? // Public email
  phone      String? // Phone number
  skills     String[] // Professional skills
  experience String?  @db.Text // Work experience description
  social     Json? // Social links as JSON
  isWorking  Boolean  @default(true) @map("is_working") // Currently working
  isFeatured Boolean  @default(false) @map("is_featured") // Featured member (displayed larger)

  // ── Translations (VI source, EN/JA/KO/ZH optional) ──────────────────────────────
  nameEn     String?  @map("name_en")
  nameJa     String?  @map("name_ja")
  nameKo     String?  @map("name_ko")
  nameZh     String?  @map("name_zh")

  roleEn     String?  @map("role_en")
  roleJa     String?  @map("role_ja")
  roleKo     String?  @map("role_ko")
  roleZh     String?  @map("role_zh")

  bioEn      String?  @map("bio_en") @db.Text
  bioJa      String?  @map("bio_ja") @db.Text
  bioKo      String?  @map("bio_ko") @db.Text
  bioZh      String?  @map("bio_zh") @db.Text

  shortBioEn String?  @map("short_bio_en")
  shortBioJa String?  @map("short_bio_ja")
  shortBioKo String?  @map("short_bio_ko")
  shortBioZh String?  @map("short_bio_zh")

  // ── HR Fields ──
  birthDate      DateTime? @map("birth_date") // Ngày tháng năm sinh
  address        String?   @map("address") // Địa chỉ thường trú
  cccd           String?   @map("cccd") // Số CCCD
  contractStart  DateTime? @map("contract_start") // Ngày bắt đầu hợp đồng
  experienceFrom Int?      @map("experience_from") // Kinh nghiệm từ (số năm)
  facebook       String?   @map("facebook") // Link Facebook
  tiktok         String?   @map("tiktok") // Link TikTok

  // Portfolio projects relation
  projects Project[]

  // Expertise relation - each member can have expertise with rating
  memberExpertise MemberExpertise[]

  // Linked staff user account
  user User?

  // ── Rank / XP Fields (denormalized for fast reads) ──
  level     Int    @default(1) @map("level")
  currentXp Int    @default(0) @map("current_xp")
  maxXp     Int    @default(100) @map("max_xp")
  rank      String @default("iron") @map("rank")

  // ── LP Balance Fields ──────────────────────────────────────────────────────
  // lockedLp     = SUM(LpAward.lpAmount) WHERE status = "pending"
  // availableLp  = SUM(LpAward.lpAmount) WHERE status = "approved" — spendable balance
  // Both denormalized; updated atomically on award create / approve / reject.
  lockedLp    Int @default(0) @map("locked_lp")
  availableLp Int @default(0) @map("available_lp")

  // PM Relations
  projectMemberships     ProjectMember[]
  bugNotesAuthored       BugNote[]       @relation("BugNoteAuthor")
  assignedTasks          Task[]          @relation("TaskAssignee")
  lpAwardsReceived       LpAward[]       @relation("LpAwardMember")
  lpAwardsApproved       LpAward[]       @relation("LpAwardApprover")
  lpTransactions         LpTransaction[]
  lpTransactionsReceived LpTransaction[] @relation("LpTransactionCounterparty")
  lpTransactionsCreated  LpTransaction[] @relation("LpTransactionCreator")
  lpRedemptions          LpRedemption[]
  referralCodes          ReferralCode[]

  // EDU relations
  instructorProfile Instructor?
  enrollments       Enrollment[] @relation("EnrollmentTeamMember")
  eduCourses        Course[]     @relation("CourseToInstructorMember")

  blogPostsAuthored BlogPost[]
  envFileEdits      EnvFile[]      @relation("EnvFileEditor")
  dailyStandups     DailyStandup[]
  mediaBookings     MediaBooking[]

  @@map("team_members")
}

// Expertise model - kỹ năng chuyên môn
model Expertise {
  id         String   @id @default(cuid())
  // ── Primary content (Vietnamese) ───────────────────────────────────────────────
  name       String   // VI: name
  category   String // VD: "frontend", "backend", "design", "management"

  // ── Translations ───────────────────────────────────────────────────────────
  nameEn     String?  @map("name_en")
  nameJa     String?  @map("name_ja")
  nameKo     String?  @map("name_ko")
  nameZh     String?  @map("name_zh")

  categoryEn String?  @map("category_en")
  categoryJa String?  @map("category_ja")
  categoryKo String?  @map("category_ko")
  categoryZh String?  @map("category_zh")

  // ── Non-translatable fields ───────────────────────────────────────────────
  icon       String? // Icon name from lucide-react
  logo       String? // Image URL for skill logo
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relation to team members
  memberExpertise MemberExpertise[]

  @@index([category, isActive])
  @@index([isActive, sortOrder])
  @@map("expertises")
}

// Member Expertise junction table - lưu rating cua mỗi thanh viên cho moi expertise
model MemberExpertise {
  id          String   @id @default(cuid())
  memberId    String   @map("member_id")
  expertiseId String   @map("expertise_id")
  level       Int      @default(5) // 1-10 rating (1=beginner, 10=expert)
  createdAt   DateTime @default(now()) @map("created_at")

  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expertise Expertise  @relation(fields: [expertiseId], references: [id], onDelete: Cascade)

  @@unique([memberId, expertiseId])
  @@map("member_expertises")
}

model ServicePackage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  type           String
  price          Int?
  priceText      String?  @map("price_text")
  shortDesc      String   @map("short_desc")
  features       String[]
  isSubscription Boolean  @default(false) @map("is_subscription")
  billingPeriod  String?  @map("billing_period")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orders Order[]
  mediaBookings MediaBooking[]

  @@map("service_packages")
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique @map("order_number")
  orderType       String          @default("package") @map("order_type") // "package" | "template" | "custom"
  packageId       String?         @map("package_id")
  package         ServicePackage? @relation(fields: [packageId], references: [id])
  templateId      String?         @map("template_id")
  template        WebTemplate?    @relation(fields: [templateId], references: [id])
  customerName    String          @map("customer_name")
  customerEmail   String          @map("customer_email")
  customerPhone   String?         @map("customer_phone")
  companyName     String?         @map("company_name")
  requirements    String?         @db.Text
  brandGuidelines String?         @map("brand_guidelines") @db.Text
  status          String          @default("pending")
  paymentStatus   String          @default("unpaid") @map("payment_status")
  totalAmount     Int?            @map("total_amount")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // ── Pricing (Platform Architecture) ──
  basePrice             Int?    @map("base_price") // Giá base tại thời điểm đặt (snapshot)
  systemCalculatedPrice Int?    @map("system_calculated_price") // = base + Σ(advanced features)
  adminOverridePrice    Int?    @map("admin_override_price") // Giá Admin ghi đè
  adminPriceNote        String? @map("admin_price_note") // Lý do điều chỉnh giá
  finalPrice            Int?    @map("final_price") // = adminOverridePrice ?? systemCalculatedPrice

  // ── XP & Rewards ──
  totalXp     Int @default(0) @map("total_xp")
  rewardLevel Int @default(1) @map("reward_level")

  // ── Payment details ──
  paymentMethod String? @map("payment_method") // "full" | "split_50_50"
  paidAmount    Int     @default(0) @map("paid_amount")

  // ── Domain ──
  domainName String? @map("domain_name")

  // Relations
  selectedAttributes OrderAttribute[]
  orderRewards       OrderReward[]
  payments           Payment[]
  statusHistory      OrderStatusHistory[]
  customerWebsites   CustomerWebsite[]

  // ── Project Management (JIRA-like) ──
  projectStatus    String?   @map("project_status") // active | on_hold | completed
  gitRepoUrl       String?   @map("git_repo_url")
  gitWebhookSecret String?   @map("git_webhook_secret")
  totalProjectLp   Int       @default(0) @map("total_project_lp")
  seoMaxLp         Int       @default(100) @map("seo_max_lp")
  isActiveProject  Boolean   @default(false) @map("is_active_project")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")

  // ── CRM Link ──
  salesLeadId String?    @map("sales_lead_id")
  salesLead   SalesLead? @relation(fields: [salesLeadId], references: [id])
  quotes      Quote[]

  // PM Relations
  projectMembers       ProjectMember[]
  epics                Epic[]
  backlogs             Backlog[]
  figmaDemos           FigmaDemo[]
  envFiles             EnvFile[]
  socialPosts          SocialPost[]
  deployments          Deployment[]
  handoverPackages     HandoverPackage[]
  dailyStandups        DailyStandup[]
  blogPosts            BlogPost[]
  gitCommits           GitCommit[]
  lpAwards             LpAward[]
  slaRules             SlaRule[]
  maintenanceContracts MaintenanceContract[]
  gscMetrics           GscMetric[]
  portalTokens         ProjectPortalToken[]

  /**
   * Referral code used to create this order
   */
  referralCodeId       String?             @map("referral_code_id")
  referralCode         ReferralCode?       @relation("ReferralCodeOrders", fields: [referralCodeId], references: [id])
  /**
   * Infrastructure tier (Basic/Pro/Enterprise) applied to this order
   */
  infrastructureTierId String?             @map("infrastructure_tier_id")
  infrastructureTier   InfrastructureTier? @relation("OrderInfrastructure", fields: [infrastructureTierId], references: [id])

  /**
   * LP allocation from quote (% per role) — used to distribute LP when order is paid
   */
  lpAllocation Json? @map("lp_allocation") // {sales: 30, design: 20, pm: 20, dev: 20, qa: 10}

  @@index([status, createdAt])
  @@index([orderType, status])
  @@index([customerEmail])
  @@index([referralCodeId])
  @@map("orders")
}

// ─── Infrastructure Pricing Tiers ──────────────────────────────────────────────

/// Infrastructure tier: determines the base hosting/ops cost component of an order.
/// Tiers are mutually exclusive per order. Examples: Basic (VPS), Pro (Cloud), Enterprise (Dedicated).
model InfrastructureTier {
  id            String   @id @default(cuid())
  slug          String   @unique @map("slug") // "basic" | "pro" | "enterprise"
  name          String // "Basic — VPS"
  nameVi        String   @map("name_vi") // "Cơ bản — VPS"
  /**
   * Monthly cost in VND for this tier. Used in pricing formula.
   */
  monthlyCost   Int      @map("monthly_cost")
  /**
   * Setup fee in VND (one-time).
   */
  setupCost     Int      @default(0) @map("setup_cost")
  /**
   * Description shown in the pricing calculator
   */
  description   String?
  descriptionVi String?  @map("description_vi")
  /**
   * Icon name (lucide-react) for the UI
   */
  icon          String?
  /**
   * Color for the UI badge
   */
  color         String   @default("#6366F1")
  /**
   * Display order in the calculator
   */
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orders Order[] @relation("OrderInfrastructure")
  quotes Quote[]

  @@map("infrastructure_tiers")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("string") @map("type") // "string" | "number" | "boolean" | "json"
  group String @default("general")

  @@map("site_settings")
}

// Home Page Slider - Admin quản lý ảnh slider
model HomeSlider {
  id        String   @id @default(cuid())
  image     String // URL ảnh slider

  // ── Primary content (Vietnamese) ───────────────────────────────────────────────
  title     String? // Tiêu đề (optional)
  subtitle  String? // Phụ đề (optional)

  // ── Translations ───────────────────────────────────────────────────────────
  titleEn   String? @map("title_en")
  titleJa   String? @map("title_ja")
  titleKo   String? @map("title_ko")
  titleZh   String? @map("title_zh")

  subtitleEn String? @map("subtitle_en")
  subtitleJa String? @map("subtitle_ja")
  subtitleKo String? @map("subtitle_ko")
  subtitleZh String? @map("subtitle_zh")

  // ── Non-translatable fields ───────────────────────────────────────────────
  link      String? // Link khi click (optional)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

