# ============================================================
# LOOP Solutions — Environment Variables Template
# ⚠️ Copy this file to .env.local and fill in real values.
# ⚠️ NEVER commit .env.local to version control.
# ⚠️ For Vercel: set real values in Vercel Dashboard → Settings → Environment Variables
# ============================================================

# ─── DATABASE (Neon PostgreSQL) ─────────────────────────────────────────────
# Get from: Neon Console → your project → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── AUTH / SECURITY ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="https://loop.vn"

# ─── SITE URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://loop.vn"

# ─── SANITY CMS ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-03-08"

# ─── GOOGLE OAUTH ────────────────────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_client_secret"

# ─── GOOGLE ANALYTICS ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GSC_VERIFICATION="your_verification_code"

# ─── TAWK.TO LIVE CHAT ──────────────────────────────────────────────────────
NEXT_PUBLIC_TAWKTO_PROPERTY_ID="your_property_id"
NEXT_PUBLIC_TAWKTO_WIDGET_ID="your_widget_id"

# ─── CLOUDINARY ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── UPSTASH REDIS ─────────────────────────────────────────────────────────
# Optional — enables distributed rate limiting + cache (production recommended)
# Leave empty → in-memory fallback (dev only, single-instance)
# Get free database: https://console.upstash.com
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_token"

# ─── INNGEST (Background Jobs) ─────────────────────────────────────────────
# Get from: https://www.inngest.com → Dashboard → Settings → API Keys
INNGEST_SIGNING_KEY="signkey-..."
INNGEST_EVENT_KEY="your_event_key"

# ─── SENTRY (Error Tracking) ──────────────────────────────────────────────
# Get from: https://sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN="https://xxxxx@xxx.ingest.us.sentry.io/xxxxx"

# ─── EMAIL: RESEND ─────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxx"

# ─── EMAIL: BREVO SMTP (transactional emails) ────────────────────────────────
BREVO_HOST="smtp-relay.brevo.com"
BREVO_PORT="587"
BREVO_USER="your-brevo-user@smtp-brevo.com"
BREVO_PASS="your-brevo-password"
EMAIL_FROM="LOOP Solutions <noreply@yourdomain.com>"

# ─── AI CONTENT (Anthropic Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-xxxxx"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_MODEL="claude-opus-4-6"

# ─── ADMIN EMAIL ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@loop.vn"
