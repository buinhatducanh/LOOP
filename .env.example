# ============================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ⚠️  IMPORTANT: Copy this file to .env.local and fill in real values.
# ⚠️  NEVER commit .env.local or .env.production to version control.
# ⚠️  All values below are PLACEHOLDERS — do not use them in production.
# ============================================================

# ─── DATABASE POSTGRESQL (NEON) ─────────────────────────────────────────────
# Get from https://neon.tech → Dashboard → Connection Details
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── AUTH / SECURITY ─────────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 32
# This secret signs NextAuth.js session tokens (min 32 characters)
AUTH_SECRET="REPLACE_WITH_A_SECURE_SECRET_AT_LEAST_32_CHARS"
NEXTAUTH_URL="https://loop.vn"

# ─── SITE URL ────────────────────────────────────────────────────────────────
# Used for sitemap, OG images, canonical URLs, JSON-LD, etc.
NEXT_PUBLIC_SITE_URL="https://loop.vn"

# ─── SANITY CMS ──────────────────────────────────────────────────────────────
# Get from https://sanity.io/manage → Your Project → API
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# ─── GOOGLE OAUTH ────────────────────────────────────────────────────────────
# Get from https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ─── GOOGLE ANALYTICS ────────────────────────────────────────────────────────
# GA4 Measurement ID (G-XXXXXXXXXX format) — used in layout.tsx
# Get from https://analytics.google.com → Admin → Data Streams → Web Stream
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# Google Search Console verification meta tag content
NEXT_PUBLIC_GSC_VERIFICATION="your_google_site_verification_code"

# ─── TAWK.TO LIVE CHAT ──────────────────────────────────────────────────────
# Get from https://www.tawk.to → Dashboard → Administration → Widget
NEXT_PUBLIC_TAWKTO_PROPERTY_ID="your_property_id"
NEXT_PUBLIC_TAWKTO_WIDGET_ID="your_widget_id"

# ─── CLOUDINARY ────────────────────────────────────────────────────────────
# Get from https://cloudinary.com → Dashboard → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── UPSTASH REDIS (Caching + Rate Limiting) ──────────────────────────────
# Optional — enables distributed Redis caching and rate limiting.
# Without these, the app falls back to in-memory rate limiting (single-instance only).
# Get from https://console.upstash.com → Your Database → REST API
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_token"

# ─── INNGEST (Background Jobs) ────────────────────────────────────────────
# Optional — enables async background jobs (emails, notifications, scheduled tasks).
# Get from https://www.inngest.com → Dashboard → Your Project → API Keys
# INNGEST_SIGNING_KEY="sig_your_signing_key"
# INNGEST_EVENT_KEY="your_event_key"

# ─── SENTRY (Error Tracking) ──────────────────────────────────────────────
# Optional — enables error monitoring and performance tracing.
# Get from https://sentry.io → Your Project → Settings → Client Keys (DSN)
# SENTRY_DSN="https://your-dsn@sentry.io/your-project-id"

# ─── RESEND (Transactional Email) ──────────────────────────────────────────
# Optional — enables transactional emails via Resend.com
# Get from https://resend.com → API Keys
# RESEND_API_KEY="re_your_api_key"

# ─── DEVELOPMENT / FE INTEGRATION ────────────────────────────────────────────────
# Set to "true" to enable mock API routes under /api/mock/*
# These routes return fake data so FE can develop without a real backend.
# Remove or set to "false" before deploying to staging/production.
NEXT_PUBLIC_MOCK_API="false"

# ─── WEBHOOKS ─────────────────────────────────────────────────────────────────
# Get from your GitHub repository → Settings → Webhooks
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret"
