{
  "name": "loop-website",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "npx tsc --noEmit && next build",
    "start": "next start",
    "lint": "next lint",
    "i18n:check": "npx tsx src/i18n/missing-keys.ts",
    "postinstall": "prisma generate && node -p \"const fs=require('fs');const p='src/generated/prisma/index.ts';if(!fs.existsSync(p))fs.writeFileSync(p,'// Re-export client for directory import\\nexport * from \\\"./client\\\";\\n')\"",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "phase:update": "npx tsx scripts/update-phase-status.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
