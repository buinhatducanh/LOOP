#!/bin/sh
echo "🔍 Running local build check before push..."
cd "$(dirname "$0")/.." || exit 1
npm run build > /tmp/loop-build.log 2>&1
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo ""
  echo "❌ Build FAILED — fix errors before pushing:"
  grep -E "^(error|Error|Type error)" /tmp/loop-build.log | head -20
  grep -E "^.* error " /tmp/loop-build.log | head -20
  echo ""
  echo "Full log: /tmp/loop-build.log"
  exit 1
fi
echo "✅ Build passed — safe to push"
exit 0
